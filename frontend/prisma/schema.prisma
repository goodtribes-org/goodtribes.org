generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Connection URL moved to prisma.config.ts's `datasource.url` — Prisma 7 no
// longer allows `url` in the schema file for Migrate (see that file's
// comment, and the PR that upgraded this repo from Prisma 6).
datasource db {
  provider = "postgresql"
}

enum SiteRole {
  USER
  ADMIN
  OWNER
}

enum ProjectRole {
  FOUNDER
  ADMIN
  MEMBER
  FOLLOWER
}

enum ProjectPhase {
  IDEA
  SPRINT
  PILOT
  PRODUCTION
  ESTABLISH
  SCALE
  IMPACT
}

// PRD 4c — replaces the dead Project.commercial Boolean (added
// 20260715220000_project_commercial, never actually written anywhere).
enum LegalType {
  COMMERCIAL_UMBRELLA
  COMMERCIAL_AB
  NONPROFIT_UMBRELLA
  NONPROFIT_OWN_ASSOC
}

enum HeroTintColor {
  CORAL
  SEAGRASS
  MUTED_TEAL
  DRY_SAGE
  WATERMELON
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
}

enum FlagReason {
  SPAM
  HARASSMENT
  OFFENSIVE
  OFF_TOPIC
  FRAUD
  ETHICS_VIOLATION
  OTHER
}

enum FlagStatus {
  PENDING
  ACTIONED
  DISMISSED
}

enum ContentHideReason {
  AUTO_FLAG_THRESHOLD
  ADMIN_ACTION
  AUTO_SPAM_DETECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Prisma's cuid() is CUID2 (@paralleldrive/cuid2), which is deliberately
  // non-sortable — unlike classic CUID1, it can't stand in for "when was
  // this row created" (see the homepage's "Nya medlemmar" bug this fixed).
  createdAt     DateTime  @default(now())
  country       String?
  bio           String?
  socialLinks   Json?     @default("{}")
  interests     Int[]     @default([])
  availability  String?
  showProfile   Boolean   @default(false)
  digestOptIn   Boolean   @default(true)
  siteRole      SiteRole  @default(USER)
  suspendedAt   DateTime?
  accounts      Account[]
  sessions      Session[]

  ownedOrganisations      Organisation[]            @relation("OwnedOrganisations")
  organisationMemberships OrganisationMember[]      @relation("OrganisationMemberships")
  joinRequests            OrganisationJoinRequest[] @relation("JoinRequests")
  skills                  UserSkill[]
  createdTasks            WorkspaceTask[]           @relation("CreatedTasks")
  files                   File[]                    @relation("OwnedFiles")
  createdKanbanCards      KanbanCard[]              @relation("CreatedKanbanCards")
  createdTodoLists        TodoList[]                @relation("CreatedTodoLists")
  createdTodoItems        TodoItem[]                @relation("CreatedTodoItems")
  ownedProjects           Project[]                 @relation("OwnedProjects")
  projectMemberships      ProjectMember[]           @relation("ProjectMemberships")
  projectJoinRequests     ProjectJoinRequest[]      @relation("ProjectJoinRequests")
  authoredIdeas           Idea[]                    @relation("AuthoredIdeas")
  ideaVotes               IdeaVote[]                @relation("IdeaVotes")
  ideaEndorsements        IdeaEndorsement[]         @relation("IdeaEndorsements")
  ideaFollowers           IdeaFollower[]            @relation("IdeaFollowers")
  authoredIdeaComments    IdeaComment[]             @relation("AuthoredIdeaComments")
  authoredBlogPosts       BlogPost[]                @relation("AuthoredBlogPosts")
  notifications           Notification[]            @relation("UserNotifications")
  assignedKanbanCards     KanbanCard[]              @relation("AssignedKanbanCards")
  createdMilestones       Milestone[]               @relation("MilestoneCreatedBy")
  activityEvents          ActivityEvent[]           @relation("ActivityEvents")
  createdProjectInvites   ProjectInvite[]           @relation("CreatedProjectInvites")
  createdWikiPages        WikiPage[]                @relation("WikiPageCreatedBy")
  updatedWikiPages        WikiPage[]                @relation("WikiPageUpdatedBy")
  updatedSitePages        SitePage[]                @relation("SitePageUpdatedBy")
  createdOrgInvites       OrgInvite[]               @relation("CreatedOrgInvites")
  fundingPledges          FundingPledge[]           @relation("FundingPledges")
  calendarEvents          CalendarEvent[]           @relation("CreatedCalendarEvents")
  completedSubtasks       KanbanCardSubtask[]       @relation("CompletedSubtasks")
  tokenLedger             TokenLedger[]             @relation("TokenLedger")
  aiTaskReviews           AiTaskReview[]            @relation("AiTaskReviews")
  createdPolls            Poll[]                    @relation("CreatedPolls")
  pollVotes               PollVote[]                @relation("UserPollVotes")
  sprintsCreated          Sprint[]                  @relation("SprintsCreated")
  sprintContributions     SprintContribution[]
  sprintVotes             SprintVote[]
  sprintComments          SprintComment[]
  impactUpdates           ImpactUpdate[]            @relation("ImpactUpdates")
  verifiedImpactReports   ImpactReport[]            @relation("VerifiedImpactReports")
  proposedIdeaRevisions   IdeaRevision[]            @relation("ProposedIdeaRevisions")
  decidedIdeaRevisions    IdeaRevision[]            @relation("DecidedIdeaRevisions")
  ideaContributions       IdeaContributor[]         @relation("IdeaContributions")
  authoredSuggestions     Suggestion[]              @relation("AuthoredSuggestions")
  reviewedSuggestions     Suggestion[]              @relation("SuggestionReviewer")
  approvedInstances       ProjectInstance[]         @relation("ApprovedInstances")
  alumni                  ProjectAlumni[]           @relation("AlumniUsers")
  mentorProfile           Mentor?                   @relation("MentorProfile")
  authoredGuides          AcademyGuide[]            @relation("GuideAuthor")
  reviewedGuides          AcademyGuide[]            @relation("GuideReviewer")
  guideCompletions        UserGuideCompletion[]     @relation("GuideCompletions")
  kudosSent               Kudos[]                   @relation("KudosSent")
  kudosReceived           Kudos[]                   @relation("KudosReceived")
  streaks                 UserStreak[]              @relation("UserStreaks")
  dreamPosts              DreamWallPost[]           @relation("DreamPosts")
  dreamReactions          DreamWallReaction[]       @relation("DreamReactions")
  projectFlags            ProjectFlag[]             @relation("FlaggedBy")
  flagReviews             ProjectFlag[]             @relation("FlagReviewer")
  ethicsReviews           EthicsReview[]            @relation("EthicsReviewer")
  kanbanComments          KanbanCardComment[]       @relation("KanbanComments")
  onboardingDone          Boolean                   @default(false)
  tourDismissedAt         DateTime?
  // Null means not yet accepted — checked at signup time (see SignupForm.tsx)
  // and, for accounts predating this consent requirement, via a global gate
  // rendered in [locale]/layout.tsx whenever either is still null.
  acceptedParticipantAgreementAt DateTime?
  acceptedCodeOfConductAt        DateTime?
  feedPosts               FeedPost[]                @relation("AuthoredFeedPosts")
  feedLikes               FeedLike[]                @relation("FeedLikes")
  feedComments            FeedComment[]             @relation("AuthoredFeedComments")
  roomParticipations      RoomParticipant[]         @relation("RoomParticipant")
  sentMessages            Message[]                 @relation("SentMessages")
  messageReactions        MessageReaction[]         @relation("MessageReactions")
  orgFlagsRaised          OrganisationFlag[]         @relation("OrgFlaggedBy")
  orgFlagReviews          OrganisationFlag[]         @relation("OrgFlagReviewer")
  orgEthicsReviews        OrganisationEthicsReview[] @relation("OrgEthicsReviewer")
  orgReviewsAuthored      OrganisationReview[]       @relation("OrgReviewAuthor")
  leanCanvasEdits         LeanCanvas[]               @relation("LeanCanvasUpdatedBy")
  leanCanvasComments      LeanCanvasComment[]        @relation("LeanCanvasCommentAuthor")
  leanCanvasVersionsSaved LeanCanvasVersion[]        @relation("LeanCanvasVersionSavedBy")
  leanCanvasDrafts        LeanCanvasDraft[]          @relation("LeanCanvasDraftOwner")
  projectPlanEdits        ProjectPlan[]              @relation("ProjectPlanUpdatedBy")
  valuePropositionEdits         ValueProposition[]        @relation("ValuePropositionUpdatedBy")
  valuePropositionVersionsSaved ValuePropositionVersion[] @relation("ValuePropositionVersionSavedBy")
  valuePropositionDrafts        ValuePropositionDraft[]   @relation("ValuePropositionDraftOwner")
  whiteboardDrafts        WhiteboardDraft[]          @relation("WhiteboardDraftOwner")
  contentFlagsRaised     ContentFlag[]               @relation("ContentFlaggedBy")
  contentFlagReviews     ContentFlag[]               @relation("ContentFlagReviewer")
  priorityChanges        KanbanCardPriorityChange[]  @relation("PriorityChanges")
  gtLedger               GtLedger[]                  @relation("GtLedger")
  phaseTransitions       PhaseTransition[]           @relation("PhaseTransitions")
  completedChecklistItems InitiativeChecklistItem[]  @relation("CompletedChecklistItems")
  createdPlatformPolls   PlatformPoll[]              @relation("CreatedPlatformPolls")
  platformPollCandidacies PlatformPollOption[]       @relation("PlatformPollCandidacies")
  platformPollVotes      PlatformPollVote[]          @relation("PlatformPollVotes")
  reviewCouncilMemberships ReviewCouncilMember[]      @relation("ReviewCouncilMemberships")
  exclusionCasesReported  ExclusionCase[]             @relation("ReportedInExclusionCases")
  exclusionCasesFiled     ExclusionCase[]             @relation("FiledExclusionCases")
  exclusionCaseVotes      ExclusionCaseVote[]         @relation("ExclusionCaseVotes")
  requestedLegalTypeChanges LegalTypeChangeRequest[]  @relation("RequestedLegalTypeChanges")
  executedLegalTypeChanges  LegalTypeChangeRequest[]  @relation("ExecutedLegalTypeChanges")
  requestedSandboxGraduations SandboxGraduationRequest[] @relation("RequestedSandboxGraduations")
  executedSandboxGraduations SandboxGraduationRequest[] @relation("ExecutedSandboxGraduations")
  proposedProfitDistributions ProfitDistributionProposal[] @relation("ProposedProfitDistributions")
  executedProfitDistributions ProfitDistributionProposal[] @relation("ExecutedProfitDistributions")
  personalProfitAllocations    PersonalProfitAllocation[]
  recordedImpactFundEntries    ImpactFundLedger[]         @relation("RecordedImpactFundEntries")
  openedImpactFundRounds       ImpactFundAllocationRound[] @relation("OpenedImpactFundRounds")
  initiatedPartnerships        Partnership[]               @relation("PartnershipInitiatedBy")
  respondedPartnerships        Partnership[]               @relation("PartnershipRespondedBy")
  createdMindMaps              MindMap[]                   @relation("CreatedMindMaps")
  projectOwnershipInterests    ProjectOwnershipInterest[]  @relation("ProjectOwnershipInterestUser")
  createdShopItems             ShopItem[]                  @relation("ShopItemCreatedBy")
  shopRedemptions               ShopRedemption[]           @relation("ShopRedemptions")
  forkContributorCredits        ForkContributorCredit[]    @relation("ForkContributorCredits")
  forkProfitSharesAsContributor ForkProfitShare[]          @relation("ForkProfitShareContributor")
  forkTokenGrantsAsContributor  ForkTokenGrant[]           @relation("ForkTokenGrantContributor")
  forkTokenGrantsGiven          ForkTokenGrant[]           @relation("ForkTokenGrantsGivenBy")
}

model Skill {
  id          String         @id @default(cuid())
  name        String         @unique
  tag         String
  description String
  slug        String         @unique
  createdAt   DateTime       @default(now())
  users       UserSkill[]
  projects    ProjectSkill[]
  organisations OrganisationSkill[]
}

model UserSkill {
  id      String   @id @default(cuid())
  userId  String
  skillId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  category    String?
  country     String?  // free text, normalized via lib/geo.ts — real geography signal for partnership matchmaking
  imageUrl    String?
  isPublic    Boolean  @default(true)
  verified    Boolean  @default(false)
  tourDismissedAt DateTime?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User                      @relation("OwnedOrganisations", fields: [ownerId], references: [id], onDelete: Cascade)
  members        OrganisationMember[]
  joinRequests   OrganisationJoinRequest[]
  rooms          Room[]                    @relation("OrgRooms")
  workspaceTasks WorkspaceTask[]           @relation("OrgTasks")
  projects       Project[]
  invites        OrgInvite[]
  neededSkills   OrganisationSkill[]
  flags          OrganisationFlag[]        @relation("OrganisationFlags")
  ethicsReviews  OrganisationEthicsReview[] @relation("OrganisationEthicsReviews")
  reviews        OrganisationReview[]      @relation("OrganisationReviews")
  files          File[]                    @relation("OrganisationFiles")
  activityEvents ActivityEvent[]
  partnerships   Partnership[]             @relation("OrganisationPartnerships")
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing OrganisationFlag row and application code already uses, so
// converting from String avoids both a data rewrite and touching any call
// site.
enum OrganisationFlagStatus {
  pending
  dismissed
  resolved
}

model OrganisationFlag {
  id             String                    @id @default(cuid())
  organisationId String
  organisation   Organisation              @relation("OrganisationFlags", fields: [organisationId], references: [id], onDelete: Cascade)
  flaggedById    String
  flaggedBy      User                      @relation("OrgFlaggedBy", fields: [flaggedById], references: [id])
  reason         String
  status         OrganisationFlagStatus    @default(pending)
  reviewedById   String?
  reviewedBy     User?                     @relation("OrgFlagReviewer", fields: [reviewedById], references: [id])
  decisionNote   String?
  ethicsReview   OrganisationEthicsReview?
  createdAt      DateTime                  @default(now())

  @@index([organisationId])
}

model OrganisationEthicsReview {
  id                 String            @id @default(cuid())
  organisationId     String
  organisation       Organisation      @relation("OrganisationEthicsReviews", fields: [organisationId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           User              @relation("OrgEthicsReviewer", fields: [reviewerId], references: [id])
  organisationFlagId String?           @unique
  organisationFlag   OrganisationFlag? @relation(fields: [organisationFlagId], references: [id])
  contentFlagId      String?           @unique
  contentFlag        ContentFlag?      @relation("OrgContentFlagEthicsReview", fields: [contentFlagId], references: [id])
  outcome            String
  note               String?
  createdAt          DateTime          @default(now())

  @@index([organisationId])
}

model OrganisationReview {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation("OrganisationReviews", fields: [organisationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("OrgReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, authorId])
  @@index([organisationId])
}

model OrganisationSkill {
  id             String   @id @default(cuid())
  organisationId String
  skillId        String
  addedAt        DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([organisationId, skillId])
}

model OrganisationMember {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole @default(MEMBER)
  joinedAt       DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrganisationMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing OrganisationJoinRequest row and application code already uses,
// so converting from String avoids both a data rewrite and touching any
// call site.
enum OrganisationJoinRequestStatus {
  pending
  approved
  rejected
}

model OrganisationJoinRequest {
  id             String                        @id @default(cuid())
  organisationId String
  userId         String
  status         OrganisationJoinRequestStatus @default(pending)
  createdAt      DateTime                      @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation("JoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model WorkspaceTask {
  id             String   @id @default(cuid())
  organisationId String
  title          String
  description    String?
  done           Boolean  @default(false)
  createdAt      DateTime @default(now())
  createdById    String

  organisation Organisation @relation("OrgTasks", fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
}

model File {
  id             String        @id @default(cuid())
  key            String        @unique
  bucket         String
  name           String
  size           Int
  mimeType       String
  ownerId        String
  owner          User          @relation("OwnedFiles", fields: [ownerId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation("ProjectFiles", fields: [projectId], references: [id], onDelete: Cascade)
  organisationId String?
  organisation   Organisation? @relation("OrganisationFiles", fields: [organisationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([projectId])
  @@index([organisationId])
  @@index([messageId])
}

model KanbanCard {
  id          String    @id @default(cuid())
  projectSlug String
  title       String
  description String?
  dueDate     DateTime?
  startDate   DateTime?
  priority    String    @default("normal")
  priorityLockedAt DateTime?
  lockedTokenValue Float?
  category    String?
  assigneeId  String?
  openToPublic Boolean  @default(false)
  claimedAt   DateTime?
  column      String    @default("BACKLOG")
  order       Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // GitHub mirror. source="github" cards are owned by the sync job and are
  // immutable in the app — see assertNotGithubCard() in src/lib/githubSync.ts.
  source          String    @default("manual")
  // ProjectV2 item node id — the identity key. A board spans repositories, so
  // githubNumber alone collides (deploy#5 vs goodtribes.org#5).
  githubItemId    String?
  githubRepoName  String?   // "owner/repo", null for draft issues
  githubStatus    String?   // raw board Status name, e.g. "apply"
  githubNumber    Int?
  githubType      String?
  githubUrl       String?
  githubState     String?
  githubMerged    Boolean   @default(false)
  githubDraft     Boolean   @default(false)
  githubLabels    String[]  @default([])
  githubAuthor    String?
  githubAssignees String[]  @default([])
  githubUpdatedAt DateTime?

  createdBy       User                       @relation("CreatedKanbanCards", fields: [createdById], references: [id], onDelete: Cascade)
  assignee        User?                      @relation("AssignedKanbanCards", fields: [assigneeId], references: [id], onDelete: SetNull)
  project         Project                    @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  estimate        TaskEstimate?
  tokenLedger     TokenLedger[]              @relation("KanbanTokens")
  aiTaskRuns      AiTaskRun[]                @relation("KanbanAiRuns")
  subtasks        KanbanCardSubtask[]
  comments        KanbanCardComment[]
  priorityChanges KanbanCardPriorityChange[]
  dependencies    KanbanCardDependency[]     @relation("CardDependsOn")
  dependents      KanbanCardDependency[]     @relation("CardDependencyOf")

  @@unique([projectSlug, githubItemId])
  @@index([projectSlug, column])
  @@index([openToPublic, assigneeId])
  @@index([projectSlug, source])
}

// PRD Gantt "koppla arbetsuppgifter till varandra" — a card can depend on
// (be blocked by) other cards. Visual/manual only: no automatic date
// cascading when a predecessor's date moves, see GanttView.
model KanbanCardDependency {
  id          String     @id @default(cuid())
  cardId      String
  card        KanbanCard @relation("CardDependsOn", fields: [cardId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   KanbanCard @relation("CardDependencyOf", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([cardId, dependsOnId])
  @@index([cardId])
  @@index([dependsOnId])
}

model KanbanCardSubtask {
  id            String     @id @default(cuid())
  cardId        String
  card          KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title         String
  done          Boolean    @default(false)
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  completedById String?
  completedBy   User?      @relation("CompletedSubtasks", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?

  @@index([cardId])
}

model HomeHeroSlide {
  id          String        @id @default(cuid())
  order       Int           @default(0)
  locale      String        @default("sv")
  imageUrl    String
  alt         String
  heading     String
  body        String
  bodyLine2   String?
  obstacles   Json?
  outro       String?
  points      Json?
  menuLabel   String
  tintColor   HeroTintColor
  tintOpacity Int           @default(10)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Singleton row (the app always reads/updates the first one) holding the
// headline shown above the hero carousel on the homepage.
model HomeHeroSettings {
  id        String   @id @default(cuid())
  locale    String   @default("sv")
  heading   String
  updatedAt DateTime @updatedAt

  @@unique([locale])
}

// Same one-row-per-locale pattern as HomeHeroSettings, for the sandbox
// page's intro textbox + its four fixed Leva/Må/Göra Gott/Dröm stort pillar
// cards (see Pillars.tsx) — editable by a site admin via
// /site-admin/sandbox-hero, same pencil-link-to-editor-page UX as the
// homepage hero carousel.
model SandboxHeroSettings {
  id               String   @id @default(cuid())
  locale           String   @default("sv")
  heroKicker       String
  heroDescription  String
  levaGottHeading  String
  levaGottBody     String
  maGottHeading    String
  maGottBody       String
  goraGottHeading  String
  goraGottBody     String
  dreamGoodHeading String
  dreamGoodBody    String
  updatedAt        DateTime @updatedAt

  @@unique([locale])
}

// Generic per-key text override for the many small static copy fields
// scattered across the homepage and Drömfabriken (Vision/Mission/Mål, Fem
// Steg, the idea band, the tools grid, phase-map/usage-now headings, and
// Drömfabriken's own remaining section headings — everything NOT already
// covered by a dedicated model like HomeHeroSlide or SandboxHeroSettings).
// `key` is the exact next-intl message path (e.g.
// "HomePage.tools.leanCanvasLabel") so the override <-> default mapping is
// self-documenting; a missing row means "use the shipped translation",
// same fallback idiom as SitePage/defaultSitePages.ts. See
// frontend/src/lib/siteCopy.ts.
model SiteCopy {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

// Editorial content for the About/Privacy/Terms pages (replaces Strapi,
// which only ever owned this same static copy). One row per slug
// ("about" | "privacy" | "terms"); the page falls back to hardcoded copy
// in the page component until a site admin saves an edit for that slug
// via EditableSitePage.tsx.
model SitePage {
  id          String   @id @default(cuid())
  slug        String
  locale      String   @default("sv")
  title       String
  body        String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SitePageUpdatedBy", fields: [updatedById], references: [id])

  @@unique([slug, locale])
}

model OnboardingStep {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  locale    String   @default("sv")
  label     String
  href      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([order, locale])
}

model KanbanCardComment {
  id           String     @id @default(cuid())
  cardId       String
  card         KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("KanbanComments", fields: [authorId], references: [id], onDelete: Cascade)
  body         String     @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?

  @@index([cardId])
}

model TodoList {
  id          String   @id @default(cuid())
  projectSlug String
  name        String
  order       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User       @relation("CreatedTodoLists", fields: [createdById], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  items     TodoItem[]

  @@index([projectSlug])
}

model TodoItem {
  id          String    @id @default(cuid())
  listId      String
  projectSlug String
  title       String
  done        Boolean   @default(false)
  dueDate     DateTime?
  order       Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User     @relation("CreatedTodoItems", fields: [createdById], references: [id], onDelete: Cascade)
  list      TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)

  @@index([listId])
  @@index([projectSlug])
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  // Short quoted tagline shown next to the title on the Startsidan/mini-hero
  // photo card caption (e.g. Storsjön "Låt odjuret leva" - 5/8-26) — set once
  // at creation via NewProjectGuide, optional, no edit UI yet.
  slogan      String?
  summary     String?
  description String?
  phase       ProjectPhase @default(IDEA)
  checklistDismissedAt DateTime?
  archivedAt  DateTime?
  // Sandbox — a real, fully-functional project, just flagged as an
  // experimental/playground one (see /sandbox). No separate "lift" step:
  // graduating out of sandbox is just flipping this back to false.
  isSandbox   Boolean  @default(false)
  // A founder-declared "looking for a new owner" flag — set explicitly by a
  // founder, never inferred from inactivity. While set, anyone logged in can
  // express interest in taking over; a founder/site-admin then picks one to
  // transfer ownership to via transferOwnership (see ownership-actions.ts).
  abandonedAt DateTime?
  hiddenAt    DateTime?
  hiddenById  String?
  hiddenReason ContentHideReason?
  category    String?
  tags        String[]
  imageUrl    String?
  links       String[] @default([])
  sdgGoals    Int[]
  legalType   LegalType @default(NONPROFIT_UMBRELLA)
  commercialUmbrellaEntityId String?
  commercialUmbrellaEntity   CommercialUmbrellaEntity? @relation(fields: [commercialUmbrellaEntityId], references: [id], onDelete: SetNull)
  // PRD 4f: a permissionless copy of this project, independent of
  // ProjectInstance's permissioned franchising model.
  forkedFromProjectId       String?
  forkedFromProject         Project?  @relation("ProjectForks", fields: [forkedFromProjectId], references: [id], onDelete: SetNull)
  forks                     Project[] @relation("ProjectForks")
  ownerId     String
  orgId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner              User                 @relation("OwnedProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  org                Organisation?        @relation(fields: [orgId], references: [id])
  members            ProjectMember[]
  joinRequests       ProjectJoinRequest[]
  kanbanCards        KanbanCard[]
  todoLists          TodoList[]
  todoItems          TodoItem[]
  blogPosts          BlogPost[]
  milestones         Milestone[]
  activityEvents     ActivityEvent[]
  invites            ProjectInvite[]
  wikiPages          WikiPage[]
  neededSkills       ProjectSkill[]
  files              File[]               @relation("ProjectFiles")
  feedPosts          FeedPost[]
  fundingCampaign    FundingCampaign?
  rooms              Room[]               @relation("ProjectRooms")
  calendarEvents     CalendarEvent[]      @relation("ProjectCalendarEvents")
  tokenLedger        TokenLedger[]        @relation("ProjectTokenLedger")
  polls              Poll[]               @relation("ProjectPolls")
  sprints            Sprint[]             @relation("ProjectSprints")
  impactMetrics      ImpactMetric[]       @relation("ProjectImpactMetrics")
  impactReports      ImpactReport[]       @relation("ProjectImpactReports")
  promotedFromIdea   Idea?                @relation("IdeaPromotedToProject")
  maturity           ProjectMaturity?     @relation("ProjectMaturity")
  githubBoard        ProjectGithubBoard?  @relation("ProjectGithubBoard")
  leanCanvas         LeanCanvas?          @relation("ProjectLeanCanvas")
  leanCanvasComments LeanCanvasComment[]  @relation("ProjectLeanCanvasComments")
  leanCanvasVersions LeanCanvasVersion[]  @relation("ProjectLeanCanvasVersions")
  projectPlan        ProjectPlan?         @relation("ProjectPlan")
  promotedFromLeanCanvasDraft LeanCanvasDraft? @relation("LeanCanvasDraftPromotedToProject")
  promotedFromWhiteboardDraft WhiteboardDraft? @relation("WhiteboardDraftPromotedToProject")
  valueProposition         ValueProposition?         @relation("ProjectValueProposition")
  valuePropositionVersions ValuePropositionVersion[] @relation("ProjectValuePropositionVersions")
  promotedFromValuePropositionDraft ValuePropositionDraft? @relation("ValuePropositionDraftPromotedToProject")
  parentInstances    ProjectInstance[]    @relation("ParentInstances")
  childInstance      ProjectInstance?     @relation("ChildInstance")
  alumni             ProjectAlumni[]      @relation("ProjectAlumni")
  openForReplication Boolean              @default(false)
  mentorships        MentorshipRequest[]  @relation("ProjectMentorships")
  kudos              Kudos[]              @relation("ProjectKudos")
  streaks            UserStreak[]         @relation("ProjectStreaks")
  flags              ProjectFlag[]        @relation("ProjectFlags")
  exclusionCases     ExclusionCase[]
  legalTypeChangeRequests LegalTypeChangeRequest[]
  sandboxGraduationRequests SandboxGraduationRequest[]
  ethicsReviews      EthicsReview[]       @relation("EthicsReviews")
  phaseTransitions   PhaseTransition[]
  checklistItems     InitiativeChecklistItem[]
  convertedFromRoom  Room?                @relation("RoomConvertedToProject")
  profitDistributionProposals ProfitDistributionProposal[]
  profitDistributions         ProfitDistribution[]
  impactFundPayouts           ImpactFundLedger[]          @relation("ImpactFundPayouts")
  impactFundPollOptions       PlatformPollOption[]        @relation("ImpactFundPollOptionProjects")
  partnerships                Partnership[]               @relation("ProjectPartnerships")
  forkProfitSharesReceived    ForkProfitShare[]           @relation("ForkProfitShareOriginalProject")
  forkContributorCredits      ForkContributorCredit[]     @relation("ForkContributorCreditForkedProject")
  forkProfitSharesGiven       ForkProfitShare[]           @relation("ForkProfitShareForkedProject")
  forkTokenGrantsGiven        ForkTokenGrant[]            @relation("ForkTokenGrantForkedProject")
  ownershipInterests          ProjectOwnershipInterest[]
  translations                ProjectTranslation[]
}

// Per-locale override of title/summary/description for a Project. The base
// columns on Project stay the canonical sv content and are never removed —
// a row here only exists for additional locales (today: en). Callers fall
// back to the base columns when no row exists, same idiom as getSitePage().
model ProjectTranslation {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  summary     String?
  description String?
  updatedAt   DateTime @updatedAt

  @@unique([projectId, locale])
  @@index([projectId])
}

// Expressions of interest in taking over a project a founder has marked
// abandonedAt on (see Project.abandonedAt) — resolved by transferOwnership
// picking one, which deletes all rows for the project.
model ProjectOwnershipInterest {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectOwnershipInterestUser", fields: [userId], references: [id], onDelete: Cascade)
  message   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
}

model ProjectSkill {
  id        String   @id @default(cuid())
  projectId String
  skillId   String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model PhaseTransition {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromPhase   ProjectPhase?
  toPhase     ProjectPhase
  changedById String
  changedBy   User          @relation("PhaseTransitions", fields: [changedById], references: [id])
  changedAt   DateTime      @default(now())

  @@index([projectId])
}

model InitiativeChecklistItem {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         ProjectPhase
  itemKey       String
  completedAt   DateTime?
  completedById String?
  completedBy   User?        @relation("CompletedChecklistItems", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([projectId, itemKey])
  @@index([projectId])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing Idea row and application code already uses, so converting from
// String avoids both a data rewrite and touching any call site.
enum IdeaStatus {
  draft
  open
  review
  shortlisted
  approved
  converted
}

model Idea {
  id             String   @id @default(cuid())
  title          String
  description    String?
  problem        String?
  solution       String?
  sdgGoals       Int[]
  category       String?
  tags           String[]
  imageUrl       String?
  targetRegion   String   @default("global")
  estimatedReach Int?
  status         IdeaStatus @default(open)
  viewCount      Int      @default(0)
  authorId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   ContentHideReason?

  author           User              @relation("AuthoredIdeas", fields: [authorId], references: [id], onDelete: Cascade)
  votes            IdeaVote[]
  endorsements     IdeaEndorsement[]
  followers        IdeaFollower[]
  comments         IdeaComment[]
  convertedFromRoom Room?            @relation("RoomConvertedToIdea")
  mindMap          MindMap?
  revisions        IdeaRevision[]
  contributors     IdeaContributor[]
  // PRD 5.16 — one-click idea->project pipeline. Idea holds the unique FK
  // (same role Room plays for convertedToProjectId/convertedToIdeaId).
  promotedToProjectId String?  @unique
  promotedToProject   Project? @relation("IdeaPromotedToProject", fields: [promotedToProjectId], references: [id], onDelete: SetNull)
  translations         IdeaTranslation[]
}

// Per-locale override of title/description/problem/solution for an Idea.
// Same fallback idiom as ProjectTranslation — base columns stay canonical sv.
model IdeaTranslation {
  id          String   @id @default(cuid())
  ideaId      String
  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String?
  problem     String?
  solution    String?
  updatedAt   DateTime @updatedAt

  @@unique([ideaId, locale])
  @@index([ideaId])
}

// PRD 5.15 co-creation — a pull-request-style proposed edit to an idea's
// description. No diff format: full proposed value + a snapshot of what it
// replaced, matching every other content model in this schema.
// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing IdeaRevision row and application code already uses, so
// converting from String avoids both a data rewrite and touching any call
// site.
enum IdeaRevisionStatus {
  pending
  accepted
  rejected
}

model IdeaRevision {
  id                  String    @id @default(cuid())
  ideaId              String
  idea                Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  proposedDescription String    @db.Text
  previousDescription String?   @db.Text
  status              IdeaRevisionStatus @default(pending)
  proposedById        String
  proposedBy          User      @relation("ProposedIdeaRevisions", fields: [proposedById], references: [id], onDelete: Cascade)
  decisionNote        String?   @db.Text
  decidedById         String?
  decidedBy           User?     @relation("DecidedIdeaRevisions", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([ideaId])
}

// PRD 5.15 — the author (from idea creation) plus anyone whose proposed
// revision was accepted. Endorsements/votes never populate this — only
// actual accepted contributions do.
model IdeaContributor {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("IdeaContributions", fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("contributor") // author | co-author
  addedAt   DateTime @default(now())

  @@unique([ideaId, userId])
}

model IdeaVote {
  id     String @id @default(cuid())
  ideaId String
  userId String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation("IdeaVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
}

model IdeaEndorsement {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation("IdeaEndorsements", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
}

model IdeaFollower {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation("IdeaFollowers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
}

// An AI-drafted, user-editable mind map attached to either an Idéverkstad
// brainstorm thread (Room, type IDEA_THREAD) or a published Idea — exactly
// one of roomId/ideaId is set, checked at the application layer (same loose
// nullable-pair convention as ActivityEvent.projectId?/organisationId?).
// One map per source for now — regenerating overwrites rather than
// versioning, keeping the MVP schema/UI simple.
model MindMap {
  id          String   @id @default(cuid())
  roomId      String?  @unique
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ideaId      String?  @unique
  idea        Idea?    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  title       String
  nodes       Json     // react-flow Node[] shape: [{id, position: {x,y}, data: {label}}]
  edges       Json     // react-flow Edge[] shape: [{id, source, target, label?}]
  createdById String
  createdBy   User     @relation("CreatedMindMaps", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing ProjectJoinRequest row and application code already uses, so
// converting from String avoids both a data rewrite and touching any call
// site.
enum ProjectJoinRequestStatus {
  pending
  approved
  rejected
}

model ProjectJoinRequest {
  id        String                   @id @default(cuid())
  projectId String
  userId    String
  message   String?
  status    ProjectJoinRequestStatus @default(pending)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model BlogPost {
  id          String   @id @default(cuid())
  projectSlug String
  authorId    String
  title       String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  author  User    @relation("AuthoredBlogPosts", fields: [authorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model IdeaComment {
  id           String   @id @default(cuid())
  ideaId       String
  authorId     String
  content      String
  createdAt    DateTime @default(now())
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?

  idea   Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  author User @relation("AuthoredIdeaComments", fields: [authorId], references: [id], onDelete: Cascade)
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing Milestone row and application code already uses, so converting
// from String avoids both a data rewrite and touching any call site.
enum MilestoneStatus {
  pending
  done
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(pending)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("MilestoneCreatedBy", fields: [createdById], references: [id])
  expenses  FundingExpense[] @relation("ExpenseMilestone")
}

model ProjectInvite {
  id          String      @id @default(cuid())
  projectId   String
  email       String?
  token       String      @unique @default(cuid())
  role        ProjectRole @default(MEMBER)
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CreatedProjectInvites", fields: [createdById], references: [id])
}

model WikiPage {
  id           String   @id @default(cuid())
  projectSlug  String
  slug         String
  title        String
  content      String   @default("")
  order        Int      @default(0)
  parentId     String?
  createdById  String
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?

  project   Project    @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  createdBy User       @relation("WikiPageCreatedBy", fields: [createdById], references: [id])
  updatedBy User?      @relation("WikiPageUpdatedBy", fields: [updatedById], references: [id])
  // A deleted parent page just orphans its children back to the top level
  // rather than cascade-deleting a whole subtree by accident.
  parent    WikiPage?  @relation("WikiPageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  WikiPage[] @relation("WikiPageHierarchy")

  @@unique([projectSlug, slug])
}

model OrgInvite {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  token       String    @unique @default(cuid())
  role        OrganisationRole @default(MEMBER)
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation("CreatedOrgInvites", fields: [createdById], references: [id])
}

model ActivityEvent {
  id             String        @id @default(cuid())
  projectId      String?
  organisationId String?
  userId         String
  type           String
  payload        Json?
  createdAt      DateTime      @default(now())

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User          @relation("ActivityEvents", fields: [userId], references: [id])

  @@index([organisationId])
  @@index([projectId])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing FundingCampaign row and application code already uses (see
// app/[locale]/projects/[slug]/(workspace)/funding/actions.ts's closeCampaign
// and funding/page.tsx), so converting from String avoids both a data
// rewrite and touching any call site. Distinct from this same model's
// campaignType/stripeOnboardingStatus String fields, which are out of scope
// here and left untouched.
enum FundingCampaignStatus {
  active
  closed
}

model FundingCampaign {
  id                     String                @id @default(cuid())
  projectId              String                @unique
  title                  String
  description            String?
  goal                   Int
  currency               String                @default("SEK")
  status                 FundingCampaignStatus @default(active)
  campaignType           String                @default("donation") // "donation" | "reward" | "token"
  tokenExchangeRate      Float?                // e.g. 100 -> "100 SEK = 1 Tribe Token"; only meaningful when campaignType == "token"
  deadline               DateTime?
  platformFee            Float                 @default(5)
  stripeAccountId        String?
  stripeOnboardingStatus String                @default("not_started") // "not_started" | "pending" | "complete", driven by the account.updated webhook
  createdAt              DateTime              @default(now())

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pledges     FundingPledge[]
  rewardTiers FundingRewardTier[]
  expenses    FundingExpense[]
}

model FundingPledge {
  id                String   @id @default(cuid())
  campaignId        String
  userId            String
  amount            Int
  message           String?
  stripeSessionId   String?  @unique
  pledgeStatus      String   @default("confirmed")
  rewardTierId      String?
  paymentMethodType String?  // mirrors PaymentIntent.payment_method_types[0], e.g. "card" | "klarna" | "bancontact"
  tokenLedgerId     String?  @unique
  createdAt         DateTime @default(now())

  campaign    FundingCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User               @relation("FundingPledges", fields: [userId], references: [id], onDelete: Cascade)
  rewardTier  FundingRewardTier? @relation(fields: [rewardTierId], references: [id], onDelete: SetNull)
  tokenLedger TokenLedger?       @relation("PledgeTokenMint", fields: [tokenLedgerId], references: [id], onDelete: SetNull)

  @@index([campaignId, userId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  projectSlug String
  project     Project   @relation("ProjectCalendarEvents", fields: [projectSlug], references: [slug], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  type        String    @default("custom")
  createdById String
  createdBy   User      @relation("CreatedCalendarEvents", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([projectSlug, startsAt])
}

model TaskEstimate {
  id           String     @id @default(cuid())
  kanbanCardId String     @unique
  kanbanCard   KanbanCard @relation(fields: [kanbanCardId], references: [id], onDelete: Cascade)
  aiHours      Float
  aiConfidence String
  aiReasoning  String     @db.Text
  manualHours  Float?
  lockedAt     DateTime?
  createdAt    DateTime   @default(now())
}


model TokenLedger {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("TokenLedger", fields: [userId], references: [id])
  projectSlug  String
  project      Project     @relation("ProjectTokenLedger", fields: [projectSlug], references: [slug])
  kanbanCardId String?
  kanbanCard   KanbanCard? @relation("KanbanTokens", fields: [kanbanCardId], references: [id], onDelete: SetNull)
  tokens       Float
  reason       String
  createdAt    DateTime    @default(now())
  gtMirrors    GtLedger[]  @relation("GtLedgerSource")
  pledgeMint   FundingPledge? @relation("PledgeTokenMint")

  @@index([userId])
  @@index([projectSlug])
}

model KanbanCardPriorityChange {
  id           String     @id @default(cuid())
  kanbanCardId String
  kanbanCard   KanbanCard @relation(fields: [kanbanCardId], references: [id], onDelete: Cascade)
  changedById  String
  changedBy    User       @relation("PriorityChanges", fields: [changedById], references: [id])
  fromPriority String
  toPriority   String
  changedAt    DateTime   @default(now())

  @@index([kanbanCardId])
}

model GtLedger {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation("GtLedger", fields: [userId], references: [id])
  tokens              Float
  sourceTokenLedgerId String?
  sourceTokenLedger   TokenLedger? @relation("GtLedgerSource", fields: [sourceTokenLedgerId], references: [id], onDelete: SetNull)
  reason              String
  createdAt           DateTime     @default(now())

  @@index([userId])
}

// Platform-wide shop, spends GT (not project-scoped Tribe Tokens) — a
// symbolic redemption: costGt is deducted via a negative GtLedger entry and
// a ShopRedemption row is logged. No fulfillment workflow (shipping, admin
// approval) — that's a deliberate scope decision, not a gap.
model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  imageUrl    String?
  costGt      Float
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("ShopItemCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  redemptions ShopRedemption[]
}

model ShopRedemption {
  id        String   @id @default(cuid())
  itemId    String
  item      ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ShopRedemptions", fields: [userId], references: [id], onDelete: Cascade)
  gtSpent   Float
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemId])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing AiTaskRun row and application code already uses, so converting
// from String avoids both a data rewrite and touching any call site.
enum AiTaskRunStatus {
  running
  awaiting_review
  approved
  rejected
  escalated
}

model AiTaskRun {
  id             String          @id @default(cuid())
  kanbanCardId   String
  kanbanCard     KanbanCard      @relation("KanbanAiRuns", fields: [kanbanCardId], references: [id], onDelete: Cascade)
  agentType      String
  status         AiTaskRunStatus @default(running)
  outputMarkdown String?         @db.Text
  attemptNumber  Int             @default(1)
  feedback       String?         @db.Text
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  reviews        AiTaskReview[]

  @@index([kanbanCardId])
}

model AiTaskReview {
  id            String    @id @default(cuid())
  aiTaskRunId   String
  aiTaskRun     AiTaskRun @relation(fields: [aiTaskRunId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User      @relation("AiTaskReviews", fields: [reviewerId], references: [id])
  decision      String
  feedback      String?   @db.Text
  tokensAwarded Float?
  createdAt     DateTime  @default(now())
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing Poll row and application code already uses, so converting from
// String avoids both a data rewrite and touching any call site.
enum PollStatus {
  open
  closed
}

model Poll {
  id            String       @id @default(cuid())
  projectSlug   String
  project       Project      @relation("ProjectPolls", fields: [projectSlug], references: [slug], onDelete: Cascade)
  createdById   String
  createdBy     User         @relation("CreatedPolls", fields: [createdById], references: [id])
  title         String
  description   String?      @db.Text
  type          String       @default("yes_no")
  status        PollStatus   @default(open)
  visibility    String       @default("live")
  isBinding     Boolean      @default(false)
  quorumPercent Float?
  deadline      DateTime?
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  options       PollOption[]
  votes         PollVote[]

  @@index([projectSlug])
}

model PollOption {
  id          String     @id @default(cuid())
  pollId      String
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label       String
  description String?
  sortOrder   Int        @default(0)
  votes       PollVote[]
}

model PollVote {
  id           String     @id @default(cuid())
  pollId       String
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("UserPollVotes", fields: [userId], references: [id])
  tokenWeight  Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([pollId, pollOptionId, userId])
  @@index([pollId, userId])
}

enum SprintStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// Chosen once at sprint creation. TOGETHER = no deadlines, a lead manually
// advances each phase via advancePhase() once the group is ready. SPREAD_OUT
// = deadline-driven auto-advance via the sprint-phase-advance cron. Both are
// equally async (no live cursors/multiplayer either way) — this only
// controls whether a phase closes on a timer or on a lead's say-so.
enum SprintPace {
  TOGETHER
  SPREAD_OUT
}

// Named SprintPhaseName (not SprintPhase) to avoid colliding with the
// SprintPhase model — Prisma's type namespace is flat. Distinct from
// ProjectPhase's unrelated SPRINT value (project lifecycle, not this
// feature).
enum SprintPhaseName {
  UNDERSTAND
  DIVERGE
  DECIDE
  PROTOTYPE
  VALIDATE
}

enum SprintPhaseStatus {
  OPEN
  CLOSED
  LOCKED
}

enum SprintContributionType {
  HMW
  SKETCH
  PROTOTYPE_LINK
  FEEDBACK
}

model Sprint {
  id                String          @id @default(cuid())
  projectSlug       String
  project           Project         @relation("ProjectSprints", fields: [projectSlug], references: [slug], onDelete: Cascade)
  createdById       String
  createdBy         User            @relation("SprintsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  name              String
  status            SprintStatus    @default(ACTIVE)
  pace              SprintPace      @default(SPREAD_OUT)
  phaseDurationDays Int?
  currentPhase      SprintPhaseName @default(UNDERSTAND)
  // Feature flag — not wired up yet, see generatePhaseSummary() stub.
  aiSummaryEnabled  Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  phases            SprintPhase[]

  @@index([projectSlug])
}

model SprintPhase {
  id            String                @id @default(cuid())
  sprintId      String
  sprint        Sprint                @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  phase         SprintPhaseName
  status        SprintPhaseStatus     @default(LOCKED)
  openedAt      DateTime?
  deadlineAt    DateTime?
  closedAt      DateTime?
  // Excalidraw scene data — only ever populated for understand/diverge.
  documentState Json?
  // Optimistic-locking counter for canvas autosave — bumped on every
  // successful write; a stale-version PATCH is rejected instead of
  // silently overwriting a concurrent async edit.
  version       Int                   @default(1)
  // Populated later when aiSummaryEnabled is true — see generatePhaseSummary().
  aiSummary     String?               @db.Text

  contributions SprintContribution[]
  votes         SprintVote[]

  @@unique([sprintId, phase])
  @@index([sprintId])
}

model SprintContribution {
  id            String                 @id @default(cuid())
  sprintPhaseId String
  sprintPhase   SprintPhase            @relation(fields: [sprintPhaseId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type          SprintContributionType
  content       String                 @db.Text
  // Author is always stored (for moderation) but only shown in the UI once
  // this is true — false during understand/diverge by design (a deliberate
  // anonymity exception to the platform's default full-disclosure
  // principle). Do not "fix" this to always show the author.
  visibleAuthor Boolean                @default(false)
  createdAt     DateTime               @default(now())

  votes         SprintVote[]
  comments      SprintComment[]

  @@index([sprintPhaseId])
}

model SprintVote {
  id             String             @id @default(cuid())
  sprintPhaseId  String
  sprintPhase    SprintPhase        @relation(fields: [sprintPhaseId], references: [id], onDelete: Cascade)
  voterId        String
  voter          User               @relation(fields: [voterId], references: [id], onDelete: Cascade)
  contributionId String
  contribution   SprintContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  // Max 3 votes per voter per phase is enforced at the application layer
  // (see castVote in sprints/[sprintId]/actions.ts) — this unique constraint
  // is just the DB-level backstop against double-voting the same
  // contribution twice, not the vote-count cap itself. Voter identity is
  // stored here but every UI surface shows aggregate counts only, never
  // who voted for what.
  @@unique([sprintPhaseId, voterId, contributionId])
  @@index([sprintPhaseId])
  @@index([voterId])
}

model SprintComment {
  id             String              @id @default(cuid())
  contributionId String
  contribution   SprintContribution  @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         SprintComment?      @relation("SprintCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        SprintComment[]     @relation("SprintCommentReplies")
  body           String              @db.Text
  createdAt      DateTime            @default(now())

  @@index([contributionId])
}

// The Foundation-owned umbrella AB(s) a commercial_umbrella project's
// product line sits under (PRD 4c), e.g. "GoodTribes Ventures AB".
model CommercialUmbrellaEntity {
  id                    String   @id @default(cuid())
  name                  String
  foundationAbOrgNumber String?
  createdAt             DateTime @default(now())

  projects Project[]
}

// PRD 4c "Övergång mellan juridisk form": a member-initiated request,
// decided by a Tribe-Token-weighted Poll (see closePoll's legal_type_change
// branch in polls/actions.ts), but only ever executed by the Foundation
// (site-admin) — an approved vote is a request, never an automatic change.
// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing LegalTypeChangeRequest row and application code already uses, so
// converting from String avoids both a data rewrite and touching any call
// site. All five values confirmed by reading every consuming call site
// (site-admin/legal-type/actions.ts, projects/[slug]/legal-type/actions.ts,
// projects/[slug]/polls/actions.ts) -- no additional/cancellation state
// exists in code.
enum LegalTypeChangeRequestStatus {
  pending
  approved_by_members
  rejected_by_members
  executed
  rejected_by_foundation
}

model LegalTypeChangeRequest {
  id            String                       @id @default(cuid())
  projectId     String
  project       Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedType LegalType
  pollId        String?
  status        LegalTypeChangeRequestStatus @default(pending)
  requestedById String
  requestedBy   User                         @relation("RequestedLegalTypeChanges", fields: [requestedById], references: [id])
  decisionNote  String?                      @db.Text
  executedById  String?
  executedBy    User?                        @relation("ExecutedLegalTypeChanges", fields: [executedById], references: [id], onDelete: SetNull)
  executedAt    DateTime?
  createdAt     DateTime                     @default(now())

  @@index([projectId])
}

// A founder-initiated application to graduate a project out of Sandbox into
// a "GoodTribes-godkänt projekt" — decided by the Foundation (site-admin)
// directly, no member poll (this is the Foundation's judgment call, not a
// project's own token holders' decision). For commercial projects, approval
// also assigns commercialUmbrellaEntityId in the same action (see
// approveSandboxGraduation) — landing under the paraply-AB and becoming
// GoodTribes-approved happen together, not as separate steps.
// Replaces the old one-click toggleSandbox self-serve flip.
//
// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing SandboxGraduationRequest row and application code already uses,
// so converting from String avoids both a data rewrite and touching any
// call site. All three values confirmed by reading every consuming call
// site (site-admin/sandbox-graduation/actions.ts, projects/[slug]/edit/
// actions.ts, EditProjectForm.tsx) -- no additional/cancellation state
// exists in code.
enum SandboxGraduationRequestStatus {
  pending
  approved
  rejected
}

model SandboxGraduationRequest {
  id            String                         @id @default(cuid())
  projectId     String
  project       Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        SandboxGraduationRequestStatus @default(pending)
  requestedById String
  requestedBy   User                           @relation("RequestedSandboxGraduations", fields: [requestedById], references: [id])
  decisionNote  String?                        @db.Text
  executedById  String?
  executedBy    User?                          @relation("ExecutedSandboxGraduations", fields: [executedById], references: [id], onDelete: SetNull)
  executedAt    DateTime?
  createdAt     DateTime                       @default(now())

  @@index([projectId])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing ProfitDistributionProposal row and application code already uses,
// so converting from String avoids both a data rewrite and touching any call
// site. Money-moving: this proposal governs a real distribution of audited
// SEK profit to Tribe Token holders once executed.
enum ProfitDistributionProposalStatus {
  pending
  approved_by_members
  rejected_by_members
  vetoed_by_foundation
  executed
}

// PRD 4a Intäktsström 2 / Utvecklingsfas 2.96, Steg 1: the board's ("styrelsen",
// represented by site-admin) proposed split of a commercial project's audited
// profit between Stiftelsens drift and the Impact-fond, decided by a
// Tribe-Token-weighted Poll (closePoll's profit_distribution branch), and only
// ever executed (or vetoed) by the Foundation — same request/vote/execute shape
// as LegalTypeChangeRequest above.
model ProfitDistributionProposal {
  id                    String    @id @default(cuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditedProfitSek      Int
  proposedOperationsPct Float
  proposedImpactFundPct Float
  pollId                String?
  status                ProfitDistributionProposalStatus @default(pending)
  proposedById          String
  proposedBy            User      @relation("ProposedProfitDistributions", fields: [proposedById], references: [id])
  decisionNote          String?   @db.Text
  executedById          String?
  executedBy            User?     @relation("ExecutedProfitDistributions", fields: [executedById], references: [id], onDelete: SetNull)
  executedAt            DateTime?
  createdAt             DateTime  @default(now())

  distribution ProfitDistribution?

  @@index([projectId])
}

// The executed record of Steg 1 once the Foundation approves a proposal —
// splits the audited profit into the three shares PRD 4a describes.
model ProfitDistribution {
  id                 String   @id @default(cuid())
  proposalId         String   @unique
  proposal           ProfitDistributionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditedProfitSek   Int
  operationsShareSek Int
  impactFundShareSek Int
  remainingShareSek  Int
  createdAt          DateTime @default(now())

  allocations PersonalProfitAllocation[]

  @@index([projectId])
}

// PRD 4a Intäktsström 2, Steg 2: each Tribe Token holder's personal share of
// remainingShareSek, proportional to their TokenLedger balance in the
// distributing project. A personal choice, not a vote — targetProjectSlug is
// null until the holder picks a recipient project, and stays null if the
// deadline sweep (see /api/cron/impact-fund-sweep) defaults it to the fund.
model PersonalProfitAllocation {
  id                 String    @id @default(cuid())
  distributionId     String
  distribution       ProfitDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountAvailableSek Int
  allocationDeadline DateTime
  targetProjectSlug  String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([userId])
  @@index([distributionId])
}

// PRD 5.52: the Impact-fond's full inflow/outflow history — always real SEK,
// never a token transaction (see Utvecklingsfas 2.96's grundprincip). Money
// movement here is admin-attested (no Stripe Connect exists yet), not an
// automatic transfer — every row is a real, auditable fact for the public
// transparency page (PRD 5.51), recorded by whoever attested the movement.
model ImpactFundLedger {
  id                    String   @id @default(cuid())
  direction             String   // "in" | "out"
  amountSek             Int
  relatedDistributionId String?
  relatedAllocationId   String?
  targetProjectId       String?
  targetProject         Project? @relation("ImpactFundPayouts", fields: [targetProjectId], references: [id], onDelete: SetNull)
  decidedByPollId       String?
  note                  String?  @db.Text
  recordedById          String?
  recordedBy            User?    @relation("RecordedImpactFundEntries", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing ImpactFundAllocationRound row and application code already uses,
// so converting from String avoids both a data rewrite and touching any call
// site. Money-moving: executing a round records real SEK outflows from the
// Impact-fond to candidate projects.
enum ImpactFundAllocationRoundStatus {
  open
  closed
  executed
}

// PRD 5.50.4: a round of the Impact-fond's outbound allocation to new
// projects, decided by a platform-wide GT-weighted vote (PlatformPoll, type
// "impact_fund_allocation") over site-admin-nominated candidate projects —
// same election mechanics as Granskningsrådet, reused for a different type.
model ImpactFundAllocationRound {
  id         String    @id @default(cuid())
  pollId     String    @unique
  status     ImpactFundAllocationRoundStatus @default(open)
  openedById String
  openedBy   User      @relation("OpenedImpactFundRounds", fields: [openedById], references: [id])
  executedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Platform-wide, GT-weighted polls (Granskningsrådet elections, PRD 5.53;
// room for future platform-level votes e.g. Impact-fund priority, Fas 2.96).
// Deliberately separate from Poll/PollOption/PollVote, which are always
// project-scoped (Poll.projectSlug is a required FK) — see PRD 4d note.
model PlatformPoll {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  type        String    @default("council_election")
  status      String    @default("open")
  seatCount   Int?
  termMonths  Int?
  deadline    DateTime?
  closedAt    DateTime?
  createdById String
  createdBy   User      @relation("CreatedPlatformPolls", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  options PlatformPollOption[]
  votes   PlatformPollVote[]
}

model PlatformPollOption {
  id              String       @id @default(cuid())
  pollId          String
  poll            PlatformPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  candidateId     String?
  candidate       User?        @relation("PlatformPollCandidacies", fields: [candidateId], references: [id], onDelete: Cascade)
  // Set when this option is a candidate project in an Impact-fund
  // allocation round (PRD 5.50.4) rather than a council-election candidate.
  linkedProjectId String?
  linkedProject   Project?     @relation("ImpactFundPollOptionProjects", fields: [linkedProjectId], references: [id], onDelete: Cascade)
  label           String
  description     String?
  sortOrder       Int          @default(0)

  votes PlatformPollVote[]
}

model PlatformPollVote {
  id           String             @id @default(cuid())
  pollId       String
  poll         PlatformPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOptionId String
  pollOption   PlatformPollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation("PlatformPollVotes", fields: [userId], references: [id])
  gtWeight     Float
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([pollId, pollOptionId, userId])
  @@index([pollId, userId])
}

model ReviewCouncilMember {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("ReviewCouncilMemberships", fields: [userId], references: [id], onDelete: Cascade)
  termStart        DateTime @default(now())
  termEnd          DateTime
  electedViaPollId String?
  createdAt        DateTime @default(now())

  @@index([userId])
}

// Granskningsrådet's uteslutningsärenden (PRD 5.53-5.55) — deliberately
// separate from ContentFlag/EthicsReview (which stay reviewer=site-admin/
// council for flagged *projects*, see canReviewEthicsFlags): reporting a
// *user* for misconduct needs richer state (project scope, response window,
// proposed decision, council votes) than the generic flag pipeline has.
model ExclusionCase {
  id                String    @id @default(cuid())
  reportedUserId    String
  reportedUser      User      @relation("ReportedInExclusionCases", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedById      String
  reportedBy        User      @relation("FiledExclusionCases", fields: [reportedById], references: [id])
  projectId         String?
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reason            String    @db.Text
  responseText      String?   @db.Text
  respondedAt       DateTime?
  status            String    @default("open")
  proposedDecision  String?
  decision          String?
  decidedAt         DateTime?
  decisionReasoning String?   @db.Text
  createdAt         DateTime  @default(now())

  votes ExclusionCaseVote[]
  @@index([reportedUserId])
  @@index([projectId])
}

model ExclusionCaseVote {
  id              String        @id @default(cuid())
  caseId          String
  case            ExclusionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  councilMemberId String
  councilMember   User          @relation("ExclusionCaseVotes", fields: [councilMemberId], references: [id])
  vote            String
  reasoning       String?       @db.Text
  createdAt       DateTime      @default(now())

  @@unique([caseId, councilMemberId])
}

model FundingRewardTier {
  id          String          @id @default(cuid())
  campaignId  String
  campaign    FundingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String?
  minAmount   Int
  maxBackers  Int?
  sortOrder   Int             @default(0)
  pledges     FundingPledge[]
  createdAt   DateTime        @default(now())

  @@index([campaignId])
}

model FundingExpense {
  id          String          @id @default(cuid())
  campaignId  String
  campaign    FundingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  amount      Int
  description String?
  receiptUrl  String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  milestoneId String?
  milestone   Milestone?      @relation("ExpenseMilestone", fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([milestoneId])
}

// PRD 5.68 — a project<->organisation sponsor/partner/supporter link. Requires
// symmetric consent: whichever side didn't propose it must accept before
// status flips to "active" and it becomes publicly visible / usable for
// matchmaking exclusion (see proposePartnership/respondToPartnership in
// lib/actions/partnerships.ts). Either side can revoke unilaterally once
// active — same leave-anytime spirit as OrganisationMember/ProjectMember.
// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing Partnership row and application code already uses, so converting
// from String avoids both a data rewrite and touching any call site.
enum PartnershipStatus {
  pending
  active
  declined
  revoked
}

model Partnership {
  id             String            @id @default(cuid())
  projectId      String
  organisationId String
  type           String            @default("partner") // "sponsor" | "partner" | "supporter"
  description    String?
  status         PartnershipStatus @default(pending)
  proposedBy     String    // "org" | "project" — who initiated, so the initiator can't also accept
  initiatedById  String
  respondedById  String?
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project      @relation("ProjectPartnerships", fields: [projectId], references: [id], onDelete: Cascade)
  organisation Organisation @relation("OrganisationPartnerships", fields: [organisationId], references: [id], onDelete: Cascade)
  initiatedBy  User         @relation("PartnershipInitiatedBy", fields: [initiatedById], references: [id])
  respondedBy  User?        @relation("PartnershipRespondedBy", fields: [respondedById], references: [id])

  @@unique([projectId, organisationId])
  @@index([organisationId])
  @@index([projectId])
}

model ImpactMetric {
  id           String         @id @default(cuid())
  projectSlug  String
  project      Project        @relation("ProjectImpactMetrics", fields: [projectSlug], references: [slug], onDelete: Cascade)
  label        String
  unit         String
  targetValue  Float?
  currentValue Float          @default(0)
  description  String?
  updates      ImpactUpdate[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectSlug])
}

model ImpactUpdate {
  id             String       @id @default(cuid())
  impactMetricId String
  impactMetric   ImpactMetric @relation(fields: [impactMetricId], references: [id], onDelete: Cascade)
  value          Float
  note           String?
  updatedById    String
  updatedBy      User         @relation("ImpactUpdates", fields: [updatedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([impactMetricId])
}

// PRD 4d — verified SDG outcome reports a fork must produce to unlock the
// `scale` -> `impact` phase transition. Distinct from ImpactMetric/ImpactUpdate
// (self-reported, ongoing progress tracking): a report is a discrete,
// externally verified claim of impact.
model ImpactReport {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation("ProjectImpactReports", fields: [projectId], references: [id], onDelete: Cascade)
  sdgGoals          Int[]
  metricDescription String
  metricValue       Float
  verifiedById      String?
  verifiedBy        User?     @relation("VerifiedImpactReports", fields: [verifiedById], references: [id])
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([projectId])
}

model ProjectMaturity {
  id               String    @id @default(cuid())
  projectSlug      String    @unique
  project          Project   @relation("ProjectMaturity", fields: [projectSlug], references: [slug], onDelete: Cascade)
  score            Int       @default(0)
  scoreBreakdown   Json?
  scaleInitiatedAt DateTime?
  scalingPlan      String?   @db.Text
  finalReport      String?   @db.Text
  calculatedAt     DateTime  @default(now())
}

// A GitHub Projects V2 board mirrored into this project's kanban. The board's
// "Status" field is the source of truth for which column an item lands in — see
// columnForStatus() in src/lib/githubColumnMap.ts.
model ProjectGithubBoard {
  id             String    @id @default(cuid())
  projectSlug    String    @unique
  project        Project   @relation("ProjectGithubBoard", fields: [projectSlug], references: [slug], onDelete: Cascade)
  ownerLogin     String
  ownerType      String    @default("organization") // "organization" | "user"
  projectNumber  Int
  // Resolved on the first successful sync, so the UI can link out and offer the
  // board's real status list before anyone opens GitHub.
  projectNodeId  String?
  projectTitle   String?
  projectUrl     String?
  statusOptions  Json      @default("[]") // [{id,name}] in board order
  columnMap      Json      @default("{}") // { "<status name>": "<COLUMN>" } — overrides only
  enabled        Boolean   @default(true)
  lastSyncedAt   DateTime?
  lastSyncError  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LeanCanvas {
  id                     String    @id @default(cuid())
  projectSlug            String    @unique
  project                Project   @relation("ProjectLeanCanvas", fields: [projectSlug], references: [slug], onDelete: Cascade)
  problem                String?   @db.Text
  alternatives           String?   @db.Text
  customerSegments       String?   @db.Text
  earlyAdopters          String?   @db.Text
  uniqueValueProposition String?   @db.Text
  concept                String?   @db.Text
  solution               String?   @db.Text
  channels               String?   @db.Text
  revenueStreams         String?   @db.Text
  costStructure          String?   @db.Text
  impact                 String?   @db.Text
  keyMetrics             String?   @db.Text
  unfairAdvantage        String?   @db.Text
  updatedById            String?
  updatedBy              User?     @relation("LeanCanvasUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// A simpler alternative to LeanCanvas — one goal/milestones/resources/risks
// form, no version history or comments. Linked from the PILOT-phase
// checklist's "sprint_lean_canvas" item (see projectPhase.ts).
model ProjectPlan {
  id          String   @id @default(cuid())
  projectSlug String   @unique
  project     Project  @relation("ProjectPlan", fields: [projectSlug], references: [slug], onDelete: Cascade)
  goal        String?  @db.Text
  milestones  String?  @db.Text
  resources   String?  @db.Text
  risks       String?  @db.Text
  updatedById String?
  updatedBy   User?    @relation("ProjectPlanUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A read-only snapshot of the full canvas, written every time any block is
// saved — linear history alongside the single mutable "current" LeanCanvas
// row, same shape as e.g. Google Docs version history.
model LeanCanvasVersion {
  id                     String    @id @default(cuid())
  projectSlug            String
  project                Project   @relation("ProjectLeanCanvasVersions", fields: [projectSlug], references: [slug], onDelete: Cascade)
  problem                String?   @db.Text
  alternatives           String?   @db.Text
  customerSegments       String?   @db.Text
  earlyAdopters          String?   @db.Text
  uniqueValueProposition String?   @db.Text
  concept                String?   @db.Text
  solution               String?   @db.Text
  channels               String?   @db.Text
  revenueStreams         String?   @db.Text
  costStructure          String?   @db.Text
  impact                 String?   @db.Text
  keyMetrics             String?   @db.Text
  unfairAdvantage        String?   @db.Text
  savedById              String?
  savedBy                User?     @relation("LeanCanvasVersionSavedBy", fields: [savedById], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())

  @@index([projectSlug, createdAt])
}

model LeanCanvasComment {
  id           String   @id @default(cuid())
  projectSlug  String
  project      Project  @relation("ProjectLeanCanvasComments", fields: [projectSlug], references: [slug], onDelete: Cascade)
  authorId     String
  author       User     @relation("LeanCanvasCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?

  @@index([projectSlug])
}

// A project-less scratchpad, same 12 fields as LeanCanvas — lets a user try
// the tool from Sandbox before any Project exists. No version history or
// comments (deliberately lighter-weight than the real thing). Once promoted,
// promotedToProjectSlug is set and the draft becomes read-only; the real
// LeanCanvas row for that project gets a copy of the field values.
model LeanCanvasDraft {
  id                     String    @id @default(cuid())
  ownerId                String
  owner                  User      @relation("LeanCanvasDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                   String?
  problem                String?   @db.Text
  alternatives           String?   @db.Text
  customerSegments       String?   @db.Text
  earlyAdopters          String?   @db.Text
  uniqueValueProposition String?   @db.Text
  concept                String?   @db.Text
  solution               String?   @db.Text
  channels               String?   @db.Text
  revenueStreams         String?   @db.Text
  costStructure          String?   @db.Text
  impact                 String?   @db.Text
  keyMetrics             String?   @db.Text
  unfairAdvantage        String?   @db.Text
  promotedToProjectSlug  String?   @unique
  promotedToProject      Project?  @relation("LeanCanvasDraftPromotedToProject", fields: [promotedToProjectSlug], references: [slug], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([ownerId])
}

// Value Proposition Canvas (Osterwalder) — a standalone tool alongside Lean
// Canvas and Whiteboard, same 3-model shape (live row + append-only version
// history + project-less sandbox draft), just 6 fields split into two
// halves: Value Map (vpProducts/vpRelievers/vpCreators) and Customer Profile
// (vpJobs/vpPains/vpGains).
model ValueProposition {
  id          String    @id @default(cuid())
  projectSlug String    @unique
  project     Project   @relation("ProjectValueProposition", fields: [projectSlug], references: [slug], onDelete: Cascade)
  vpJobs      String?   @db.Text
  vpPains     String?   @db.Text
  vpGains     String?   @db.Text
  vpProducts  String?   @db.Text
  vpRelievers String?   @db.Text
  vpCreators  String?   @db.Text
  updatedById String?
  updatedBy   User?     @relation("ValuePropositionUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ValuePropositionVersion {
  id          String    @id @default(cuid())
  projectSlug String
  project     Project   @relation("ProjectValuePropositionVersions", fields: [projectSlug], references: [slug], onDelete: Cascade)
  vpJobs      String?   @db.Text
  vpPains     String?   @db.Text
  vpGains     String?   @db.Text
  vpProducts  String?   @db.Text
  vpRelievers String?   @db.Text
  vpCreators  String?   @db.Text
  savedById   String?
  savedBy     User?     @relation("ValuePropositionVersionSavedBy", fields: [savedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([projectSlug, createdAt])
}

model ValuePropositionDraft {
  id                    String    @id @default(cuid())
  ownerId               String
  owner                 User      @relation("ValuePropositionDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String?
  vpJobs                String?   @db.Text
  vpPains               String?   @db.Text
  vpGains               String?   @db.Text
  vpProducts            String?   @db.Text
  vpRelievers           String?   @db.Text
  vpCreators            String?   @db.Text
  promotedToProjectSlug String?   @unique
  promotedToProject     Project?  @relation("ValuePropositionDraftPromotedToProject", fields: [promotedToProjectSlug], references: [slug], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([ownerId])
}

// A project-less Excalidraw scratchpad — same idea as LeanCanvasDraft, for
// the "try the whiteboard before starting a project" Sandbox tool. Single
// owner only (no live collaborators, unlike SprintPhase.documentState —
// there's no team to collaborate with before a Project/Sprint exists).
// version mirrors SprintPhase's optimistic-lock counter. On promotion, the
// documentState is copied into a real Sprint's first (UNDERSTAND) phase.
model WhiteboardDraft {
  id                     String    @id @default(cuid())
  ownerId                String
  owner                  User      @relation("WhiteboardDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                   String?
  documentState          Json?
  version                Int       @default(1)
  promotedToProjectSlug  String?   @unique
  promotedToProject      Project?  @relation("WhiteboardDraftPromotedToProject", fields: [promotedToProjectSlug], references: [slug], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([ownerId])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing ProjectInstance row and application code already uses (review
// decision values from /api/projects/instances/review/route.ts), so
// converting from String avoids both a data rewrite and touching any call site.
enum ProjectInstanceStatus {
  pending
  approved
  rejected
}

model ProjectInstance {
  id           String                @id @default(cuid())
  parentSlug   String
  parent       Project               @relation("ParentInstances", fields: [parentSlug], references: [slug], onDelete: Cascade)
  childSlug    String                @unique
  child        Project               @relation("ChildInstance", fields: [childSlug], references: [slug], onDelete: Cascade)
  region       String
  country      String?               // free text, normalized via lib/geo.ts same as User.country — powers the network dashboard's world map
  status       ProjectInstanceStatus @default(pending)
  approvedById String?
  approvedBy   User?                 @relation("ApprovedInstances", fields: [approvedById], references: [id])
  createdAt    DateTime              @default(now())

  @@unique([parentSlug, childSlug])
}

model ProjectAlumni {
  id            String   @id @default(cuid())
  projectSlug   String
  project       Project  @relation("ProjectAlumni", fields: [projectSlug], references: [slug], onDelete: Cascade)
  userId        String
  user          User     @relation("AlumniUsers", fields: [userId], references: [id])
  tokensEarned  Float    @default(0)
  badgeIssuedAt DateTime @default(now())
  finalReport   String?  @db.Text

  @@unique([projectSlug, userId])
  @@index([projectSlug])
}

model Mentor {
  id         String              @id @default(cuid())
  userId     String              @unique
  user       User                @relation("MentorProfile", fields: [userId], references: [id], onDelete: Cascade)
  categories String[]
  bio        String?
  verified   Boolean             @default(false)
  requests   MentorshipRequest[]
  createdAt  DateTime            @default(now())
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing MentorshipRequest row and application code already uses (see
// app/[locale]/mentors/actions.ts), so converting from String avoids both a
// data rewrite and touching any call site.
enum MentorshipRequestStatus {
  pending
  accepted
  completed
}

model MentorshipRequest {
