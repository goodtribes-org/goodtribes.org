model DreamWallPost {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation("DreamPosts", fields: [userId], references: [id], onDelete: Cascade)
  dreamText    String
  reactions    DreamWallReaction[]
  createdAt    DateTime            @default(now())
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?
}

model DreamWallReaction {
  id              String        @id @default(cuid())
  dreamWallPostId String
  dreamWallPost   DreamWallPost @relation(fields: [dreamWallPostId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation("DreamReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji           String
  createdAt       DateTime      @default(now())

  @@unique([dreamWallPostId, userId, emoji])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing ProjectFlag row and application code already uses, so
// converting from String avoids both a data rewrite and touching any call
// site.
enum ProjectFlagStatus {
  pending
  dismissed
  resolved
}

model ProjectFlag {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation("ProjectFlags", fields: [projectId], references: [id], onDelete: Cascade)
  flaggedById  String
  flaggedBy    User              @relation("FlaggedBy", fields: [flaggedById], references: [id])
  reason       String
  status       ProjectFlagStatus @default(pending)
  reviewedById String?
  reviewedBy   User?             @relation("FlagReviewer", fields: [reviewedById], references: [id])
  decisionNote String?
  ethicsReview EthicsReview?
  createdAt    DateTime          @default(now())

  @@index([projectId])
}

model EthicsReview {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation("EthicsReviews", fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User         @relation("EthicsReviewer", fields: [reviewerId], references: [id])
  projectFlagId String?      @unique
  projectFlag   ProjectFlag? @relation(fields: [projectFlagId], references: [id])
  contentFlagId String?      @unique
  contentFlag   ContentFlag? @relation("ProjectContentFlagEthicsReview", fields: [contentFlagId], references: [id])
  outcome       String
  note          String?
  createdAt     DateTime     @default(now())

  @@index([projectId])
}

// Generic moderation flag for individual comments/posts/messages, as opposed
// to ProjectFlag/OrganisationFlag which flag an entire project/org and drive
// a dedicated ethics-review workflow. targetType/targetId is the same loose
// union pairing FeedComment/FeedLike already use.
model ContentFlag {
  id           String     @id @default(cuid())
  targetType   String
  targetId     String
  // Nullable: a system-generated flag (source "AUTO", see proactiveModeration.ts)
  // has no human reporter.
  flaggedById  String?
  flaggedBy    User?      @relation("ContentFlaggedBy", fields: [flaggedById], references: [id], onDelete: Cascade)
  source       String     @default("USER") // USER | AUTO
  reason       FlagReason
  note         String?
  status       FlagStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?      @relation("ContentFlagReviewer", fields: [reviewedById], references: [id])
  decisionNote String?
  createdAt    DateTime   @default(now())
  reviewedAt   DateTime?

  ethicsReview    EthicsReview?             @relation("ProjectContentFlagEthicsReview")
  orgEthicsReview OrganisationEthicsReview? @relation("OrgContentFlagEthicsReview")

  @@unique([targetType, targetId, flaggedById])
  @@index([targetType, targetId])
  @@index([status])
}

// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing Suggestion row and application code already uses, so converting
// from String avoids both a data rewrite and touching any call site.
enum SuggestionStatus {
  pending
  reviewed
  dismissed
}

// Platform-wide improvement suggestions ("Ge förslag på förbättringar") —
// a private author<->admin channel, never shown to other users, unlike the
// public Ideas feed. Any logged-in user, not project-membership-gated.
model Suggestion {
  id           String           @id @default(cuid())
  authorId     String
  author       User             @relation("AuthoredSuggestions", fields: [authorId], references: [id], onDelete: Cascade)
  body         String           @db.Text
  status       SuggestionStatus @default(pending)
  reviewedById String?
  reviewedBy   User?            @relation("SuggestionReviewer", fields: [reviewedById], references: [id])
  decisionNote String?          @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([status])
}

enum RoomType {
  DM
  GROUP
  PROJECT_CHANNEL
  ORG_CHANNEL
  IDEA_THREAD
}

enum RoomPostingPolicy {
  ALL_MEMBERS
  LEADS_ONLY
}

enum RoomParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

model Room {
  id             String            @id @default(cuid())
  type           RoomType
  name           String?
  description    String?
  // Cover image for the thread's topic (e.g. an idea-thread's subject
  // matter) — never a participant's photo, see IDEA_THREAD card display.
  imageUrl       String?
  pairKey        String?           @unique
  projectId      String?
  project        Project?          @relation("ProjectRooms", fields: [projectId], references: [id], onDelete: Cascade)
  organisationId String?
  organisation   Organisation?     @relation("OrgRooms", fields: [organisationId], references: [id], onDelete: Cascade)
  postingPolicy  RoomPostingPolicy @default(ALL_MEMBERS)
  order          Int               @default(0)
  pinned         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  lastMessageAt  DateTime          @default(now())

  convertedToIdeaId    String?  @unique
  convertedToIdea      Idea?    @relation("RoomConvertedToIdea", fields: [convertedToIdeaId], references: [id], onDelete: SetNull)
  convertedToProjectId String?  @unique
  convertedToProject   Project? @relation("RoomConvertedToProject", fields: [convertedToProjectId], references: [id], onDelete: SetNull)

  participants RoomParticipant[]
  messages     Message[]
  mindMap      MindMap?

  @@unique([projectId, name])
  @@unique([organisationId, name])
  @@index([projectId])
  @@index([organisationId])
  @@index([lastMessageAt])
}

// PRD 4f: lineage record for a fork — every original contributor (project
// TokenLedger holders, or a sandbox Room's message authors) is credited here
// regardless of whether they also received a profit share or token grant.
model ForkContributorCredit {
  id                String   @id @default(cuid())
  forkedProjectId   String
  forkedProject     Project  @relation("ForkContributorCreditForkedProject", fields: [forkedProjectId], references: [id], onDelete: Cascade)
  originalProjectId String?
  creditedUserId    String
  creditedUser      User     @relation("ForkContributorCredits", fields: [creditedUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([forkedProjectId])
}

// PRD 4f: the mandatory compensation floor — proportional to the
// contributor's Tribe Token stake in the original project at fork time.
// Consumed by executeProfitDistribution (site-admin/profit-distribution)
// before the fork's own TokenLedger holders get their split.
model ForkProfitShare {
  id                        String   @id @default(cuid())
  forkedProjectId           String
  forkedProject             Project  @relation("ForkProfitShareForkedProject", fields: [forkedProjectId], references: [id], onDelete: Cascade)
  originalProjectId         String
  originalProject           Project  @relation("ForkProfitShareOriginalProject", fields: [originalProjectId], references: [id], onDelete: Cascade)
  originalContributorUserId String
  originalContributor       User     @relation("ForkProfitShareContributor", fields: [originalContributorUserId], references: [id], onDelete: Cascade)
  sharePercent              Float
  createdAt                 DateTime @default(now())

  @@index([forkedProjectId])
}

// PRD 4f: the forker's entirely optional, self-chosen top-up — real, newly
// minted Tribe Tokens in the forked project (see awardTokens in lib/tokens.ts),
// never a transfer of the contributor's original tokens.
model ForkTokenGrant {
  id                        String   @id @default(cuid())
  forkedProjectId           String
  forkedProject             Project  @relation("ForkTokenGrantForkedProject", fields: [forkedProjectId], references: [id], onDelete: Cascade)
  originalProjectId         String
  originalContributorUserId String
  originalContributor       User     @relation("ForkTokenGrantContributor", fields: [originalContributorUserId], references: [id], onDelete: Cascade)
  tribeTokensGranted        Float
  grantedById               String
  grantedBy                 User     @relation("ForkTokenGrantsGivenBy", fields: [grantedById], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now())

  @@index([forkedProjectId])
}

model RoomParticipant {
  id         String              @id @default(cuid())
  roomId     String
  room       Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation("RoomParticipant", fields: [userId], references: [id], onDelete: Cascade)
  role       RoomParticipantRole @default(MEMBER)
  lastReadAt DateTime            @default(now())
  createdAt  DateTime            @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model Message {
  id             String            @id @default(cuid())
  roomId         String
  room           Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation("SentMessages", fields: [authorId], references: [id], onDelete: Cascade)
  body           String            @db.Text
  threadParentId String?
  threadParent   Message?          @relation("MessageThread", fields: [threadParentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  threadReplies  Message[]         @relation("MessageThread")
  reactions      MessageReaction[]
  attachments    File[]
  isAi           Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  editedAt       DateTime?
  deletedAt      DateTime?
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   ContentHideReason?

  @@index([roomId, createdAt])
  @@index([threadParentId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model FeedPost {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation("AuthoredFeedPosts", fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  imageUrl     String?
  // Null = a post on the global site-wide feed (today's only behavior).
  // Set = posted from within a project's own scoped feed — never shown on
  // the global feed, see lib/activityFeed.ts's project-scope mode.
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?

  @@index([createdAt])
  @@index([projectId])
}

// Likes on any feed item (FeedPost, BlogPost, Milestone, Project, Idea,
// ActivityEvent, Message, KanbanCardComment, IdeaComment). Not a
// Prisma relation to the target — targetType/targetId is looked up by the
// app layer, matching how the feed already treats these as a loose union.
model FeedLike {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("FeedLikes", fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// Comments on any feed item — same loose targetType/targetId pairing as FeedLike.
model FeedComment {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation("AuthoredFeedComments", fields: [authorId], references: [id], onDelete: Cascade)
  targetType   String
  targetId     String
  body         String
  createdAt    DateTime @default(now())
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?

  @@index([targetType, targetId])
}
