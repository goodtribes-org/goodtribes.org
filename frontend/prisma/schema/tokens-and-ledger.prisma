// Tribe Token (project-scoped) and GT Token (platform-wide) ledgers — see src/lib/tokens.ts's awardTokens as the single mint choke point. Part of the hardened-boundary work from the architecture memo: TokenLedger.idempotencyKey (PR #83) lets awardTokens refuse a duplicate mint for the same real-world event. Double-entry bookkeeping and a structured audit trail (LedgerJournalEntry below) landed 2026-08-29 -- see CLAUDE.md.


model TokenLedger {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("TokenLedger", fields: [userId], references: [id])
  projectSlug  String
  project      Project     @relation("ProjectTokenLedger", fields: [projectSlug], references: [slug])
  kanbanCardId String?
  kanbanCard   KanbanCard? @relation("KanbanTokens", fields: [kanbanCardId], references: [id], onDelete: SetNull)
  tokens       Float
  reason       String
  // Optional caller-supplied dedup key for awardTokens (e.g. a Stripe session
  // id) — lets the mint chokepoint itself refuse a second award for the same
  // real-world event, instead of every caller having to invent its own
  // protection (see the architecture memo's point on hardening the ledger
  // boundary). Nullable+unique: Postgres allows multiple NULLs, so callers
  // with no natural key are unaffected.
  idempotencyKey String?  @unique
  createdAt    DateTime    @default(now())
  gtMirrors    GtLedger[]  @relation("GtLedgerSource")
  pledgeMint   FundingPledge? @relation("PledgeTokenMint")
  journalEntries LedgerJournalEntry[]

  @@index([userId])
  @@index([projectSlug])
}

model GtLedger {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation("GtLedger", fields: [userId], references: [id])
  tokens              Float
  sourceTokenLedgerId String?
  sourceTokenLedger   TokenLedger? @relation("GtLedgerSource", fields: [sourceTokenLedgerId], references: [id], onDelete: SetNull)
  reason              String
  createdAt           DateTime     @default(now())
  journalEntries      LedgerJournalEntry[]

  @@index([userId])
}

enum LedgerCurrency {
  TRIBE_TOKEN
  GT
}

enum LedgerAccount {
  MINT
  USER
}

// Double-entry audit trail layered additively on top of TokenLedger/GtLedger
// above -- the memo's "hardened boundary" point 2, second half (idempotency
// keys were the first half, PR #83). This is a parallel record, not a
// replacement: every existing balance read (getGtBalance, profit-
// distribution allocation, PlatformPoll vote weighting, ...) keeps summing
// TokenLedger.tokens/GtLedger.tokens directly, completely unaffected by this
// table existing.
//
// awardTokens() (src/lib/tokens.ts) writes one MINT leg and one USER leg per
// currency it touches, sharing one transactionId -- by construction, the sum
// of `amount` across all rows sharing a transactionId is always 0 (negative
// on the MINT leg, positive on the USER leg). This is the actual invariant a
// real ledger gives you: total supply is reconcilable against a known
// counter-account instead of implicitly trusted.
//
// Immutable/append-only by design: reverseCardTokens() writes NEW opposite-
// signed legs for a fresh transactionId rather than deleting the original
// ones, so the audit trail always shows what actually happened, including
// reversals -- exactly what "structured audit trail as first-class" means.
//
// Scope: only the awardTokens/reverseCardTokens chokepoint is covered so
// far, not silently -- two other real write sites are tracked, not missed.
// (1) ShopRedemption's direct negative GtLedger spend (shop/actions.ts) has
// no natural MINT-side counterpart the way an award does (it's a spend, not
// a mint) and needs its own accounting design, not shoehorned into this one.
// (2) The AI-task-review approval route (api/ai-agent/review/route.ts)
// currently bypasses awardTokens() entirely -- a separate, already-flagged
// bug -- and will get journal coverage automatically once it's routed
// through awardTokens like every other award site.
model LedgerJournalEntry {
  id            String         @id @default(cuid())
  // Groups every leg of one economic event. Invariant, not enforced by the
  // database (Postgres has no native check across an arbitrary row set):
  // the sum of `amount` for every row sharing a transactionId is always 0.
  transactionId String
  currency      LedgerCurrency
  account       LedgerAccount
  // Signed: negative for the MINT leg, positive for the USER leg (or the
  // reverse on a reversal's opposite-signed pair).
  amount        Float
  userId        String?
  projectSlug   String?
  tokenLedgerId String?
  tokenLedger   TokenLedger? @relation(fields: [tokenLedgerId], references: [id], onDelete: SetNull)
  gtLedgerId    String?
  gtLedger      GtLedger?    @relation(fields: [gtLedgerId], references: [id], onDelete: SetNull)
  reason        String
  createdAt     DateTime     @default(now())

  @@index([transactionId])
  @@index([userId])
  @@index([tokenLedgerId])
  @@index([gtLedgerId])
}

// Platform-wide shop, spends GT (not project-scoped Tribe Tokens) — a
// symbolic redemption: costGt is deducted via a negative GtLedger entry and
// a ShopRedemption row is logged. No fulfillment workflow (shipping, admin
// approval) — that's a deliberate scope decision, not a gap.
model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  imageUrl    String?
  costGt      Float
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("ShopItemCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  redemptions ShopRedemption[]
}

model ShopRedemption {
  id        String   @id @default(cuid())
  itemId    String
  item      ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ShopRedemptions", fields: [userId], references: [id], onDelete: Cascade)
  gtSpent   Float
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemId])
}
