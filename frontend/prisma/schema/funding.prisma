// Crowdfunding campaigns (Utvecklingsfas 3) — pledges, reward tiers, expenses.


// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing FundingCampaign row and application code already uses (see
// app/[locale]/projects/[slug]/(workspace)/funding/actions.ts's closeCampaign
// and funding/page.tsx), so converting from String avoids both a data
// rewrite and touching any call site. Distinct from this same model's
// campaignType String field, which isn't a status field by name (the
// lint-schema-status-enums.mjs convention only matches *Status fields) and
// stays out of scope here.
enum FundingCampaignStatus {
  active
  closed
}

// Lowercase for the same reason as FundingCampaignStatus above -- matches
// the exact "not_started"/"pending"/"complete" strings the account.updated
// Stripe webhook and the connect route already write, so no code call site
// needed to change when this was converted from String.
enum StripeOnboardingStatus {
  not_started
  pending
  complete
}

model FundingCampaign {
  id                     String                 @id @default(cuid())
  projectId              String                 @unique
  title                  String
  description            String?
  goal                   Int
  currency               String                 @default("SEK")
  status                 FundingCampaignStatus  @default(active)
  campaignType           String                 @default("donation") // "donation" | "reward" | "token"
  tokenExchangeRate      Float?                 // e.g. 100 -> "100 SEK = 1 Tribe Token"; only meaningful when campaignType == "token"
  deadline               DateTime?
  platformFee            Float                  @default(5)
  stripeAccountId        String?
  stripeOnboardingStatus StripeOnboardingStatus @default(not_started) // driven by the account.updated webhook
  createdAt              DateTime               @default(now())

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pledges     FundingPledge[]
  rewardTiers FundingRewardTier[]
  expenses    FundingExpense[]
}

// Single member today (every pledge is written as "confirmed" -- see
// stripe/webhook/route.ts) -- kept as a real enum anyway rather than a
// String default, same as every other status field in this schema, so a
// future pledge state (refunded, disputed, ...) is additive instead of
// needing this exact conversion done again.
enum FundingPledgeStatus {
  confirmed
}

model FundingPledge {
  id                String              @id @default(cuid())
  campaignId        String
  userId            String
  amount            Int
  message           String?
  stripeSessionId   String?             @unique
  pledgeStatus      FundingPledgeStatus @default(confirmed)
  rewardTierId      String?
  paymentMethodType String?             // mirrors PaymentIntent.payment_method_types[0], e.g. "card" | "klarna" | "bancontact"
  tokenLedgerId     String?             @unique
  createdAt         DateTime            @default(now())

  campaign    FundingCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User               @relation("FundingPledges", fields: [userId], references: [id], onDelete: Cascade)
  rewardTier  FundingRewardTier? @relation(fields: [rewardTierId], references: [id], onDelete: SetNull)
  tokenLedger TokenLedger?       @relation("PledgeTokenMint", fields: [tokenLedgerId], references: [id], onDelete: SetNull)

  @@index([campaignId, userId])
}

model FundingRewardTier {
  id          String          @id @default(cuid())
  campaignId  String
  campaign    FundingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String?
  minAmount   Int
  maxBackers  Int?
  sortOrder   Int             @default(0)
  pledges     FundingPledge[]
  createdAt   DateTime        @default(now())

  @@index([campaignId])
}

model FundingExpense {
  id          String          @id @default(cuid())
  campaignId  String
  campaign    FundingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  amount      Int
  description String?
  receiptUrl  String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  milestoneId String?
  milestone   Milestone?      @relation("ExpenseMilestone", fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([milestoneId])
}

enum RecurringFundingType {
  MEMBERSHIP_FEES
  GRANT
  SUBSCRIPTION
  REVENUE_SHARE
  OTHER
}

enum RecurringFundingInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
  OTHER
}

// Self-reported tracking of recurring funding (membership fees, standing
// grants, subscriptions, revenue share) -- deliberately NOT a Stripe
// recurring-billing integration, which is a separate, much larger project.
// A row's endedAt (not deletion) is how a source stops being active, so
// historical funding data is never lost.
model RecurringFundingSource {
  id          String                   @id @default(cuid())
  projectId   String
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        RecurringFundingType     @default(OTHER)
  label       String
  sourceName  String?
  amountSek   Int
  interval    RecurringFundingInterval @default(MONTHLY)
  startedAt   DateTime?
  endedAt     DateTime?
  note        String?                  @db.Text
  createdById String
  createdBy   User                     @relation("RecurringFundingSourceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                 @default(now())
  updatedById String?
  updatedBy   User?                    @relation("RecurringFundingSourceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime                 @updatedAt

  @@index([projectId])
}

enum FundingSourceCategory {
  FOUNDATION
  GOVERNMENT_GRANT
  EU_PROGRAM
  CORPORATE_CSR
  OTHER
}

enum FundingSourceStatus {
  ACTIVE
  ARCHIVED
}

// Site-admin-curated catalog of external funding sources (foundations,
// government/EU grants, corporate CSR) -- deliberately a structured model,
// not a hardcoded list, so it can grow and be updated over time. Matched
// against projects by src/lib/fundingMatching.ts.
model FundingSource {
  id                 String                @id @default(cuid())
  name               String
  organization       String?
  description        String?               @db.Text
  category           FundingSourceCategory @default(OTHER)
  sdgGoals           Int[]
  eligibleLegalTypes LegalType[]
  tags               String[]              @default([])
  minAmountSek       Int?
  maxAmountSek       Int?
  applicationUrl     String?
  hasApiIntegration  Boolean               @default(false)
  requiresBankId     Boolean               @default(true)
  region             String?
  rollingDeadline    Boolean               @default(false)
  nextDeadline       DateTime?
  status             FundingSourceStatus   @default(ACTIVE)
  createdById        String
  createdBy          User                  @relation(fields: [createdById], references: [id])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  matches      FundingMatch[]
  applications FundingApplication[]

  @@index([status])
}

// One row per (source, project) match -- unique index makes matching runs
// idempotent (see fundingMatching.ts). dismissedAt lets a project lead hide
// an irrelevant match without deleting the record.
model FundingMatch {
  id              String        @id @default(cuid())
  fundingSourceId String
  fundingSource   FundingSource @relation(fields: [fundingSourceId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  matchedAt       DateTime      @default(now())
  notifiedAt      DateTime?
  dismissedAt     DateTime?
  dismissedById   String?

  @@unique([fundingSourceId, projectId])
  @@index([projectId])
}

// Lowercase (not SCREAMING_SNAKE_CASE) deliberately, matching this schema's
// existing convention for enums whose values are compared against literal
// strings across many call sites from day one (see e.g. ExclusionCaseStatus).
enum FundingApplicationStatus {
  draft
  ai_drafted
  ready_for_review
  submitted
  awarded
  rejected
  withdrawn
}

model FundingApplication {
  id                      String                   @id @default(cuid())
  fundingSourceId         String
  fundingSource           FundingSource            @relation(fields: [fundingSourceId], references: [id])
  projectId               String
  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                  FundingApplicationStatus @default(draft)
  amountRequestedSek      Int?
  deadline                DateTime?
  draftMarkdown           String?                  @db.Text
  draftGeneratedAt        DateTime?
  approvedById            String?
  approvedAt              DateTime?
  submittedById           String?
  submittedAt             DateTime?
  outcome                 String?
  outcomeAmountSek        Int?
  outcomeNote             String?                  @db.Text
  decidedAt               DateTime?
  deadlineEscalationStage Int                      @default(0)
  createdById             String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([projectId])
  @@index([fundingSourceId])
  @@index([deadline])
}
