// AI kanban agent task runs — gated on ANTHROPIC_API_KEY, see src/lib/anthropic.ts.


// Lowercase (not the SCREAMING_SNAKE_CASE used elsewhere in this schema,
// e.g. FlagStatus) deliberately -- matches the exact string values every
// existing AiTaskRun row and application code already uses, so converting
// from String avoids both a data rewrite and touching any call site.
enum AiTaskRunStatus {
  running
  awaiting_review
  approved
  rejected
  escalated
}

model AiTaskRun {
  id             String          @id @default(cuid())
  kanbanCardId   String
  kanbanCard     KanbanCard      @relation("KanbanAiRuns", fields: [kanbanCardId], references: [id], onDelete: Cascade)
  agentType      String
  status         AiTaskRunStatus @default(running)
  outputMarkdown String?         @db.Text
  attemptNumber  Int             @default(1)
  feedback       String?         @db.Text
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  reviews        AiTaskReview[]

  @@index([kanbanCardId])
}

model AiTaskReview {
  id            String    @id @default(cuid())
  aiTaskRunId   String
  aiTaskRun     AiTaskRun @relation(fields: [aiTaskRunId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User      @relation("AiTaskReviews", fields: [reviewerId], references: [id])
  decision      String
  feedback      String?   @db.Text
  tokensAwarded Float?
  createdAt     DateTime  @default(now())
}

// Per-project, per-tool AI involvement preference (PRD "AI-läge: agent vs.
// manuellt"). A generic table rather than a field per tool -- there are
// 15+ workspace tools already and more keep shipping, so this avoids a
// schema change every time a new one gets an AI entry point. Structurally
// this is also what makes it "not a global switch": a project can run one
// tool in AGENT mode and another in MANUAL mode simultaneously.
// How much AI does on a project, a phase, a step or a tool (see
// src/lib/aiMode.ts's resolveAiMode for how the levels combine):
//   AGENT  — "Låt AI göra": AI performs the work and puts it up for review
//   ASSIST — "AI hjälper mig": AI suggests/reviews on request, never writes itself
//   MANUAL — "Jag gör själv": no AI calls at all
enum AiMode {
  MANUAL
  AGENT
  ASSIST
}

// TASK/PHASE/ALL is a scale of autonomy, not a second on/off switch --
// AGENT mode always still routes through the existing AiTaskRun -> REVIEW
// column -> human-approval gate before anything counts as done or pays
// tokens (see ai-agent/review/route.ts). Raising agentScope only changes
// how much gets queued for that same review, never who approves it.
enum AiAgentScope {
  TASK
  PHASE
  ALL
}

model ToolAiPreference {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Values come from the shared constant list in src/lib/aiToolKeys.ts --
  // a free string (not an enum) since the set of AI-capable tools is
  // expected to keep growing, same reasoning as KanbanCard.category.
  toolKey     String
  aiMode      AiMode       @default(MANUAL)
  agentScope  AiAgentScope @default(TASK)
  updatedById String?
  updatedBy   User?        @relation("ToolAiPreferenceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@unique([projectId, toolKey])
}

enum AiProjectPlanStatus {
  pending
  approved
  rejected
}

// The staged, not-yet-real plan an AI_INTAKE dialogue produces before a
// human approves it -- same "inte skarpt förrän godkänt" principle as
// LeanCanvasDraft/ValuePropositionDraft, but covering several artifact
// types (project fields, Lean Canvas, Value Proposition, an initial
// backlog) in one row instead of one per tool. roomId is @unique: at most
// one plan per room, so generating a new one (e.g. "Be AI ändra") is always
// an upsert on this same row, not a fresh insert.
model AiProjectPlan {
  id                 String              @id @default(cuid())
  roomId             String              @unique
  room               Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          User                @relation("AiProjectPlanCreatedBy", fields: [createdById], references: [id])
  status             AiProjectPlanStatus @default(pending)
  planJson           Json
  revisionCount      Int                 @default(0)
  createdProjectSlug String?
  decidedById        String?
  decidedBy          User?               @relation("AiProjectPlanDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Phase-level AI mode override (steg 1 of the AI-guided project start). No
// row = inherit from the project. Keyed by *display* phase (IDEA covers the
// merged IDEA/SPRINT step, see projectPhase.ts's toDisplayPhase).
model ProjectPhaseAiSetting {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase
  aiMode      AiMode
  updatedById String?
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@unique([projectId, phase])
}

// Step-level AI mode override for a guide/checklist step (stepKey is an
// InitiativeChecklistItem itemKey, e.g. "lean_canvas_created"). No row =
// inherit from the phase. The most specific level wins.
model ProjectStepAiSetting {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey     String
  aiMode      AiMode
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([projectId, stepKey])
}

// Whether a fact in a project field is known or assumed. Everything starts
// as ANTAR; it becomes VET when the user said it themselves (e.g. in the
// Drömsamtal) or confirms it.
enum FieldKnowledgeStatus {
  VET
  ANTAR
}

// Who wrote a field's current content.
enum FieldAuthor {
  USER
  AI
  AI_EDITED // an AI draft a human has since edited
}

// Provenance per project field ("vet/antar" + who wrote it + sources), one
// generic table for every tool instead of extra columns per canvas. entity
// is a key from src/lib/fieldProvenance.ts's PROVENANCE_FIELDS
// ("project", "leanCanvas", "valueProposition", ...); field is that
// entity's column name. No row = written before provenance existed, which
// counts as human-written (AI must never overwrite it).
model FieldProvenance {
  id          String               @id @default(cuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entity      String
  field       String
  status      FieldKnowledgeStatus @default(ANTAR)
  author      FieldAuthor
  // [{ url?: string, note?: string }] — evidence behind the content. AI
  // research must always cite; free-form so later tools can add detail.
  sources     Json?
  updatedById String?
  updatedAt   DateTime             @updatedAt
  createdAt   DateTime             @default(now())

  // Also serves "all provenance for one entity" lookups (prefix match).
  @@unique([projectId, entity, field])
}

enum DreamConversationStatus {
  in_progress
  summary_pending
  confirmed
  abandoned
}

// Drömsamtalet: the AI dialogue at the start of a new project, before the
// Snabbstart guide (steg 1 of the AI-guided project start). The chat itself
// lives in an AI_INTAKE Room (messages, realtime, access via
// RoomParticipant); this row holds the structured side: which of the six
// areas (see src/lib/dreamConversation.ts) are covered, a short note per
// area, the user's open questions, and — once generated — the "Så här
// förstod jag dig" summary. Nothing is written to a project until that
// summary is approved; the project is created then and linked here.
model DreamConversation {
  id            String                  @id @default(cuid())
  roomId        String                  @unique
  room          Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String
  user          User                    @relation("DreamConversations", fields: [userId], references: [id], onDelete: Cascade)
  // The mode chosen at the vägval (AGENT or ASSIST — MANUAL skips the
  // conversation entirely); becomes the project's aiMode.
  aiMode        AiMode
  // { covered: string[], notes: Record<area, string> }
  state         Json                    @default("{}")
  // string[] — what the user didn't know yet ("vet inte" is a valid answer)
  openQuestions Json                    @default("[]")
  summary       Json?
  // Progress of the AI filling in the Idé phase after the conversation:
  // { about, leanCanvas, valueProposition, marketScan, interviewGuide:
  //   "pending" | "running" | "done" | "failed" | "skipped" }. Drives the
  // "AI skriver…" placeholders on the Idé overview page.
  fillStatus    Json?
  status        DreamConversationStatus @default(in_progress)
  projectId     String?                 @unique
  project       Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([userId, status])
}

enum AiFieldSuggestionStatus {
  pending
  used
  ignored
}

// An AI suggestion for one project field that is shown NEXT TO the field
// instead of being written into it — used in ASSIST mode ("AI hjälper
// mig": the AI never fills anything in itself) and whenever the field
// already has human content (canAiWrite in src/lib/fieldProvenance.ts).
// The human decides: Använd / Använd delar / Ignorera. At most one pending
// suggestion per field; a newer one replaces it.
model AiFieldSuggestion {
  id          String                  @id @default(cuid())
  projectId   String
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entity      String
  field       String
  content     String                  @db.Text
  status      AiFieldSuggestionStatus @default(pending)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())

  @@index([projectId, entity, status])
}

enum AiInsightKind {
  CRITIQUE             // Kritikern: at most 3 objections to the AI's Idé drafts
  INTERVIEW_SYNTHESIS  // learnings from the logged interviews + a verdict per assumption
  PHASE_GATE           // the one-page decision brief at the Idé → Uppstart gate
  UPPSTART_GATE        // the same, at the Uppstart → Lansering gate (sprint results)
  LANSERING_GATE       // the same, at the Lansering → Etablera gate (pilot go/no-go)
  ETABLERA_GATE        // the same, at the Etablera → Skala gate (ready to scale?)
}

// Something the AI concluded about a project as a whole — shown on the Idé
// overview, newest per kind wins. Stored (not recomputed on every view)
// because each one is a paid model call. content's shape depends on kind:
// see src/lib/ideaInsights.ts.
model AiInsight {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      AiInsightKind
  content   Json
  createdAt DateTime      @default(now())

  @@index([projectId, kind, createdAt])
}

enum PhaseGateOutcome {
  CONTINUE // move on to the next phase
  ADJUST   // stay; test what's still unclear
  PIVOT    // stay; rework what the evidence contradicted
  PAUSE    // put the project on hold (marked as ownerless so others can take over)
}

// A decision taken at a phase gate — a decision point, not a lock: the
// phase can still be changed by hand as before. "missing" records which
// gate criteria weren't met when the decision was taken ("went ahead
// without interviews"), for transparency.
model PhaseGateDecision {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromPhase   ProjectPhase
  outcome     PhaseGateOutcome
  note        String?          @db.Text
  missing     String[]         @default([])
  decidedById String
  createdAt   DateTime         @default(now())

  @@index([projectId, createdAt])
}

// Progress of the AI's background drafting for one phase's one-page
// overview (Uppstart and later; Idé keeps DreamConversation.fillStatus).
// status is { <section>: "pending" | "running" | "done" | "failed" | "skipped" }.
model PhaseFill {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     ProjectPhase
  status    Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([projectId, phase])
}
