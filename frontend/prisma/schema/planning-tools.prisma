// Lean Canvas, project plans, and value-proposition drafting tools.


model LeanCanvas {
  id                     String    @id @default(cuid())
  projectSlug            String    @unique
  project                Project   @relation("ProjectLeanCanvas", fields: [projectSlug], references: [slug], onDelete: Cascade)
  problem                String?   @db.Text
  alternatives           String?   @db.Text
  customerSegments       String?   @db.Text
  earlyAdopters          String?   @db.Text
  uniqueValueProposition String?   @db.Text
  concept                String?   @db.Text
  solution               String?   @db.Text
  channels               String?   @db.Text
  revenueStreams         String?   @db.Text
  costStructure          String?   @db.Text
  impact                 String?   @db.Text
  keyMetrics             String?   @db.Text
  unfairAdvantage        String?   @db.Text
  updatedById            String?
  updatedBy              User?     @relation("LeanCanvasUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// A simpler alternative to LeanCanvas — one goal/milestones/resources/risks
// form, no version history or comments. Linked from the PILOT-phase
// checklist's "sprint_lean_canvas" item (see projectPhase.ts).
model ProjectPlan {
  id          String   @id @default(cuid())
  projectSlug String   @unique
  project     Project  @relation("ProjectPlan", fields: [projectSlug], references: [slug], onDelete: Cascade)
  goal        String?  @db.Text
  milestones  String?  @db.Text
  resources   String?  @db.Text
  risks       String?  @db.Text
  updatedById String?
  updatedBy   User?    @relation("ProjectPlanUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A read-only snapshot of the full canvas, written every time any block is
// saved — linear history alongside the single mutable "current" LeanCanvas
// row, same shape as e.g. Google Docs version history.
model LeanCanvasVersion {
  id                     String    @id @default(cuid())
  projectSlug            String
  project                Project   @relation("ProjectLeanCanvasVersions", fields: [projectSlug], references: [slug], onDelete: Cascade)
  problem                String?   @db.Text
  alternatives           String?   @db.Text
  customerSegments       String?   @db.Text
  earlyAdopters          String?   @db.Text
  uniqueValueProposition String?   @db.Text
  concept                String?   @db.Text
  solution               String?   @db.Text
  channels               String?   @db.Text
  revenueStreams         String?   @db.Text
  costStructure          String?   @db.Text
  impact                 String?   @db.Text
  keyMetrics             String?   @db.Text
  unfairAdvantage        String?   @db.Text
  savedById              String?
  savedBy                User?     @relation("LeanCanvasVersionSavedBy", fields: [savedById], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())

  @@index([projectSlug, createdAt])
}

model LeanCanvasComment {
  id           String   @id @default(cuid())
  projectSlug  String
  project      Project  @relation("ProjectLeanCanvasComments", fields: [projectSlug], references: [slug], onDelete: Cascade)
  authorId     String
  author       User     @relation("LeanCanvasCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason ContentHideReason?

  @@index([projectSlug])
}

// A project-less scratchpad, same 12 fields as LeanCanvas — lets a user try
// the tool from Sandbox before any Project exists. No version history or
// comments (deliberately lighter-weight than the real thing). Once promoted,
// promotedToProjectSlug is set and the draft becomes read-only; the real
// LeanCanvas row for that project gets a copy of the field values.
model LeanCanvasDraft {
  id                     String    @id @default(cuid())
  ownerId                String
  owner                  User      @relation("LeanCanvasDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                   String?
  problem                String?   @db.Text
  alternatives           String?   @db.Text
  customerSegments       String?   @db.Text
  earlyAdopters          String?   @db.Text
  uniqueValueProposition String?   @db.Text
  concept                String?   @db.Text
  solution               String?   @db.Text
  channels               String?   @db.Text
  revenueStreams         String?   @db.Text
  costStructure          String?   @db.Text
  impact                 String?   @db.Text
  keyMetrics             String?   @db.Text
  unfairAdvantage        String?   @db.Text
  promotedToProjectSlug  String?   @unique
  promotedToProject      Project?  @relation("LeanCanvasDraftPromotedToProject", fields: [promotedToProjectSlug], references: [slug], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([ownerId])
}

// Value Proposition Canvas (Osterwalder) — a standalone tool alongside Lean
// Canvas and Whiteboard, same 3-model shape (live row + append-only version
// history + project-less sandbox draft), just 6 fields split into two
// halves: Value Map (vpProducts/vpRelievers/vpCreators) and Customer Profile
// (vpJobs/vpPains/vpGains).
model ValueProposition {
  id          String    @id @default(cuid())
  projectSlug String    @unique
  project     Project   @relation("ProjectValueProposition", fields: [projectSlug], references: [slug], onDelete: Cascade)
  vpJobs      String?   @db.Text
  vpPains     String?   @db.Text
  vpGains     String?   @db.Text
  vpProducts  String?   @db.Text
  vpRelievers String?   @db.Text
  vpCreators  String?   @db.Text
  updatedById String?
  updatedBy   User?     @relation("ValuePropositionUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ValuePropositionVersion {
  id          String    @id @default(cuid())
  projectSlug String
  project     Project   @relation("ProjectValuePropositionVersions", fields: [projectSlug], references: [slug], onDelete: Cascade)
  vpJobs      String?   @db.Text
  vpPains     String?   @db.Text
  vpGains     String?   @db.Text
  vpProducts  String?   @db.Text
  vpRelievers String?   @db.Text
  vpCreators  String?   @db.Text
  savedById   String?
  savedBy     User?     @relation("ValuePropositionVersionSavedBy", fields: [savedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([projectSlug, createdAt])
}

model ValuePropositionDraft {
  id                    String    @id @default(cuid())
  ownerId               String
  owner                 User      @relation("ValuePropositionDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String?
  vpJobs                String?   @db.Text
  vpPains               String?   @db.Text
  vpGains               String?   @db.Text
  vpProducts            String?   @db.Text
  vpRelievers           String?   @db.Text
  vpCreators            String?   @db.Text
  promotedToProjectSlug String?   @unique
  promotedToProject     Project?  @relation("ValuePropositionDraftPromotedToProject", fields: [promotedToProjectSlug], references: [slug], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([ownerId])
}

// Target-audience interview log (checklist item target_audience_interviews,
// Fas 1/Idé, see lib/projectPhase.ts) — one row per interview conducted.
// Plain free-text fields, no sanitizeHtml() — same plain-text discipline as
// LeanCanvasComment.body (React's default escaping, no HTML authored here).
model InterviewLogEntry {
  id          String   @id @default(cuid())
  projectSlug String
  project     Project  @relation("ProjectInterviewLogEntries", fields: [projectSlug], references: [slug], onDelete: Cascade)
  date        DateTime
  personaName String
  painPoint   String   @db.Text
  validated   Boolean
  quotes      String?  @db.Text
  createdById String
  createdBy   User     @relation("InterviewLogEntryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([projectSlug])
}

enum MarketScanEntryType {
  COMPETITOR
  TREND
  PARTNER_PROSPECT
  REGULATION
}

// Lightweight competitive/market-environment scan and early partner
// prospecting (checklist item market_scan_partners, Fas 1/Idé) — a running,
// informal list. Not the same thing as Partnership (scaling-and-partnerships.prisma),
// which is the later, formal, consent-based org<->project relationship —
// this module is deliberately upstream of and separate from that model.
model MarketScanEntry {
  id            String              @id @default(cuid())
  projectSlug   String
  project       Project             @relation("ProjectMarketScanEntries", fields: [projectSlug], references: [slug], onDelete: Cascade)
  type          MarketScanEntryType
  name          String
  description   String              @db.Text
  relevanceNote String?             @db.Text
  sourceUrl     String?
  createdById   String
  createdBy     User                @relation("MarketScanEntryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([projectSlug])
}

enum ChannelPlanStatus {
  PLANNED
  ACTIVE
  DONE
}

// Launch & marketing plan (checklist item launch_marketing_plan_created,
// Fas 3/Lansering) — one per project: narrative fields plus two repeatable
// child lists (channels, milestones). Deliberately no version history
// (unlike LeanCanvas) — this is a formalization document edited
// occasionally around launch, not an iterative ideation tool.
model LaunchPlan {
  id             String                @id @default(cuid())
  projectSlug    String                @unique
  project        Project               @relation("ProjectLaunchPlan", fields: [projectSlug], references: [slug], onDelete: Cascade)
  targetAudience String?               @db.Text
  positioning    String?               @db.Text
  budgetOverview String?               @db.Text
  successMetrics String?               @db.Text
  updatedById    String?
  updatedBy      User?                 @relation("LaunchPlanUpdatedBy", fields: [updatedById], references: [id])
  channels       LaunchPlanChannel[]
  milestones     LaunchPlanMilestone[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model LaunchPlanChannel {
  id           String            @id @default(cuid())
  launchPlanId String
  launchPlan   LaunchPlan        @relation(fields: [launchPlanId], references: [id], onDelete: Cascade)
  name         String
  tactic       String?           @db.Text
  owner        String?
  budget       String?
  plannedDate  DateTime?
  status       ChannelPlanStatus @default(PLANNED)
  createdAt    DateTime          @default(now())

  @@index([launchPlanId])
}

model LaunchPlanMilestone {
  id           String     @id @default(cuid())
  launchPlanId String
  launchPlan   LaunchPlan @relation(fields: [launchPlanId], references: [id], onDelete: Cascade)
  date         DateTime
  description  String
  done         Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([launchPlanId])
}

enum PilotDecision {
  PENDING
  GO
  NO_GO
}

// Pilot evaluation (checklist items pilot_success_criteria/
// pilot_executed_documented/pilot_results_collected/pilot_go_no_go, Fas 3/
// Lansering) — one per project, same "formalization document, no version
// history" shape as ProjectPlan/LaunchPlan above.
model PilotEvaluation {
  id                String        @id @default(cuid())
  projectSlug       String        @unique
  project           Project       @relation("ProjectPilotEvaluation", fields: [projectSlug], references: [slug], onDelete: Cascade)
  successCriteria   String?       @db.Text
  executionNotes    String?       @db.Text
  resultsSummary    String?       @db.Text
  decision          PilotDecision @default(PENDING)
  updatedById       String?
  updatedBy         User?         @relation("PilotEvaluationUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// Establishment notes (checklist items process_scaled_up/supporter_base_built,
// Fas 4/Etablera) — the two ESTABLISH items with no other existing tool to
// link to (partnerships/wiki/funding already cover the rest of that phase).
model EstablishmentPlan {
  id                  String   @id @default(cuid())
  projectSlug         String   @unique
  project             Project  @relation("ProjectEstablishmentPlan", fields: [projectSlug], references: [slug], onDelete: Cascade)
  scaledProcessNotes  String?  @db.Text
  supporterBaseNotes  String?  @db.Text
  updatedById         String?
  updatedBy           User?    @relation("EstablishmentPlanUpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Scaling plan (checklist items scaling_goals_set/new_geographies_identified/
// expansion_capital_secured/local_teams_or_license, Fas 5/Skala) — separate
// from the scale_vs_fork_decided decision itself (Project.openForReplication/
// ProjectInstance, see the scale/ workspace page), this is the planning
// document for once that decision is made.
model ScalingPlan {
  id                 String   @id @default(cuid())
  projectSlug        String   @unique
  project            Project  @relation("ProjectScalingPlan", fields: [projectSlug], references: [slug], onDelete: Cascade)
  goals              String?  @db.Text
  geographies        String?  @db.Text
  capitalPlan        String?  @db.Text
  teamOrLicenseModel String?  @db.Text
  updatedById        String?
  updatedBy          User?    @relation("ScalingPlanUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum NextStepDecision {
  UNDECIDED
  CONTINUE
  REPLICATE
  CLOSE_RESPONSIBLY
}

// Impact follow-up (checklist items impact_externally_verified/
// results_celebrated/next_step_decided, Fas 6/Impact) — separate from
// ImpactReport (scaling-and-partnerships.prisma), which is the discrete,
// site-admin-verified SDG-outcome claims; this is the founder's own
// closing-the-loop notes once those reports exist.
model ImpactFollowup {
  id                         String           @id @default(cuid())
  projectSlug                String           @unique
  project                    Project          @relation("ProjectImpactFollowup", fields: [projectSlug], references: [slug], onDelete: Cascade)
  externalVerificationNotes  String?          @db.Text
  celebrationNotes           String?          @db.Text
  nextStepDecision           NextStepDecision @default(UNDECIDED)
  updatedById                String?
  updatedBy                  User?            @relation("ImpactFollowupUpdatedBy", fields: [updatedById], references: [id])
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
}

// A project-less Excalidraw scratchpad — same idea as LeanCanvasDraft, for
// the "try the whiteboard before starting a project" Sandbox tool. Single
// owner only (no live collaborators, unlike SprintPhase.documentState —
// there's no team to collaborate with before a Project/Sprint exists).
// version mirrors SprintPhase's optimistic-lock counter. On promotion, the
// documentState is copied into a real Sprint's first (UNDERSTAND) phase.
model WhiteboardDraft {
  id                     String    @id @default(cuid())
  ownerId                String
  owner                  User      @relation("WhiteboardDraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                   String?
  documentState          Json?
  version                Int       @default(1)
  promotedToProjectSlug  String?   @unique
  promotedToProject      Project?  @relation("WhiteboardDraftPromotedToProject", fields: [promotedToProjectSlug], references: [slug], onDelete: SetNull)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([ownerId])
}
