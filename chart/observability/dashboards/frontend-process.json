{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource that scrapes /api/metrics from the frontend pod (see chart/templates/frontend-service.yaml's prometheus.io/* annotations).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "GoodTribes — Frontend Process",
  "description": "Process-level health for the frontend Deployment, sourced from prom-client's collectDefaultMetrics() at /api/metrics (frontend/src/lib/metrics.ts). No per-route/HTTP request metrics exist yet — see CLAUDE.md's Fas 2 note on why that was deliberately left out. Companion alert rules: chart/observability/alerts/frontend-process.yaml.",
  "tags": ["goodtribes", "frontend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(process_start_time_seconds, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 0,
        "description": "Placeholder — this repo can't confirm from a sandboxed session what job label your scrape config assigns to the frontend target. Pick it from the dropdown once this dashboard is imported against a real Prometheus."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Target up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "up{job=\"$job\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Restarts (30m window)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "changes(process_start_time_seconds{job=\"$job\"}[30m])", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "description": "Backs the FrontendFrequentRestarts alert — a crash-loop signature when this stays above ~2.",
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }] }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "time() - process_start_time_seconds{job=\"$job\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU usage (cores) vs 1000m limit",
      "description": "chart/values.yaml frontend.resources.limits.cpu",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"$job\"}[5m])", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "thresholds": { "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 1.0 }] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory (RSS) vs 512Mi limit",
      "description": "chart/values.yaml frontend.resources.limits.memory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"$job\"}", "legendFormat": "RSS — {{instance}}", "refId": "A" },
        { "expr": "nodejs_heap_size_used_bytes{job=\"$job\"}", "legendFormat": "heap used — {{instance}}", "refId": "B" },
        { "expr": "nodejs_heap_size_total_bytes{job=\"$job\"}", "legendFormat": "heap total — {{instance}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "thresholds": { "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 536870912 }] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Event loop lag (p50/p90/p99)",
      "description": "Backs the FrontendHighEventLoopLag alert — sustained lag means requests (including health checks) are queuing behind blocking work.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "nodejs_eventloop_lag_p50_seconds{job=\"$job\"}", "legendFormat": "p50 — {{instance}}", "refId": "A" },
        { "expr": "nodejs_eventloop_lag_p90_seconds{job=\"$job\"}", "legendFormat": "p90 — {{instance}}", "refId": "B" },
        { "expr": "nodejs_eventloop_lag_p99_seconds{job=\"$job\"}", "legendFormat": "p99 — {{instance}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "thresholds": { "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 0.1 }] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GC duration rate by kind",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(nodejs_gc_duration_seconds_sum{job=\"$job\"}[5m])", "legendFormat": "{{kind}} — {{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Active handles / requests",
      "description": "Rough proxy for open sockets/timers — relevant given long-lived SSE connections (chat, kanban live-sync) hold a handle each for the connection's lifetime.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "nodejs_active_handles_total{job=\"$job\"}", "legendFormat": "handles — {{instance}}", "refId": "A" },
        { "expr": "nodejs_active_requests_total{job=\"$job\"}", "legendFormat": "requests — {{instance}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    }
  ]
}
