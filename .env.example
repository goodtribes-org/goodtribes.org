# PostgreSQL
POSTGRES_USER=goodtribes
POSTGRES_PASSWORD=changeme
POSTGRES_DB=goodtribes
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme

# Frontend (Next.js)
NEXT_PUBLIC_MEILI_HOST=http://localhost:7700
NEXT_PUBLIC_MEILI_SEARCH_KEY=
AUTH_SECRET=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=

# GitHub integration
# Org-wide fine-grained PAT, read-only: Metadata + Issues + Pull requests.
# Named GITHUB_PAT rather than GITHUB_TOKEN — the latter is reserved in Actions.
GITHUB_PAT=

# Redis — pub/sub bus for live SSE (chat, kanban), presence, and rate limiting.
# docker-compose builds REDIS_URL from this; in Kubernetes both REDIS_PASSWORD
# and REDIS_URL live in the goodtribes-secret Secret.
REDIS_PASSWORD=changeme

# Stripe (crowdfunding & payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BUCKET=goodtribes-public
S3_PRIVATE_BUCKET=goodtribes-private
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/goodtribes-public
